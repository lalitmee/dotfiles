# Deny by default: never collect Herdr runtime state or new files implicitly.
/*
!/.gitignore
!/.stow-local-ignore
!/README.md
!/.config/
/.config/*
!/.config/herdr-app/
/.config/herdr-app/*
!/.config/herdr-app/settings.json
!/.config/herdr-app/keys.json
!/.config/herdr-app/layouts/
!/.config/herdr-app/themes/
/.config/herdr-app/layouts/*
!/.config/herdr-app/layouts/lalitmee-main.json
/.config/herdr-app/themes/*
!/.config/herdr-app/themes/cobalt2.json
!/.config/herdr-app/mods/
/.config/herdr-app/mods/*
!/.config/herdr-app/mods/worktree-keys/
/.config/herdr-app/mods/worktree-keys/*
!/.config/herdr-app/mods/worktree-keys/main.js
