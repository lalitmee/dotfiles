{
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md",
      "CONTEXT.md"
    ]
  },
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "enableAutoUpdate": false,
    "preferredEditor": "neovim",
    "vimMode": true
  },
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -r '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -x '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ]; then /bin/sh '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -r '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -x '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ]; then /bin/sh '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -r '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -x '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ]; then /bin/sh '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status waiting",
            "type": "command"
          }
        ],
        "matcher": "ToolPermission"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "workmux register-agent",
            "type": "command"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -r '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ] && [ -x '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh' ]; then /bin/sh '/home/lalitmee/.orca/agent-hooks/gemini-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "inactiveMcpServers": {
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~/Projects/"
      ],
      "command": "npx",
      "trust": true
    },
    "git": {
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "command": "uvx",
      "trust": true
    },
    "github": {
      "headers": {
        "Authorization": "Bearer $GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "trust": true
    },
    "gitmcp": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/{owner}/{repo}"
      ],
      "command": "npx"
    },
    "mcp-sequentialthinking-tools": {
      "args": [
        "-y",
        "mcp-sequentialthinking-tools"
      ],
      "command": "npx",
      "env": {
        "MAX_HISTORY_SIZE": "1000"
      }
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx"
    },
    "next-devtools": {
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "command": "npx",
      "trust": true
    },
    "sequential-thinking": {
      "args": [
        "--from",
        "git+https://github.com/arben-adm/mcp-sequential-thinking",
        "--with",
        "portalocker",
        "mcp-sequential-thinking"
      ],
      "command": "uvx"
    },
    "server-sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    },
    "time": {
      "args": [
        "mcp-server-time"
      ],
      "command": "uvx"
    }
  },
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "command": "npx",
      "trust": true
    },
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "command": "npx",
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "6000"
      },
      "trust": true
    },
    "crash": {
      "args": [
        "-y",
        "crash-mcp"
      ],
      "command": "npx",
      "trust": true
    },
    "fetch": {
      "args": [
        "mcp-server-fetch"
      ],
      "command": "uvx",
      "trust": true
    },
    "linear": {
      "httpUrl": "https://mcp.linear.app/mcp"
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest",
        "--extension"
      ],
      "command": "npx",
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "$PLAYWRIGHT_MCP_EXTENSION_TOKEN"
      },
      "trust": true
    }
  },
  "model": {
    "name": "gemini-3-flash-preview"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "customThemes": {
      "Cobalt2": {
        "Background": "#193549",
        "Comment": "#0088FF",
        "DarkGray": "#0D3A58",
        "DiffAdded": "#2D7067",
        "DiffRemoved": "#700009",
        "Foreground": "#FFFFFF",
        "GradientColors": [
          "#FFC600",
          "#00AAFF",
          "#FF628C"
        ],
        "Gray": "#808080",
        "LightBlue": "#80FCFF",
        "AccentBlue": "#00AAFF",
        "AccentCyan": "#80FCFF",
        "AccentGreen": "#88FF88",
        "AccentPurple": "#967EFB",
        "AccentRed": "#FF0000",
        "AccentYellow": "#FFC600",
        "name": "Cobalt2",
        "type": "custom"
      }
    },
    "hideBanner": true,
    "hideTips": true,
    "theme": "Cobalt2"
  }
}
