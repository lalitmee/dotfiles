{
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md",
      "CONTEXT.md"
    ]
  },
  "general": {
    "checkpointing": {
      "enabled": true
    },
    "enableAutoUpdate": false,
    "preferredEditor": "neovim",
    "vimMode": true
  },
  "inactivehooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done || true",
            "type": "command"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working || true",
            "type": "command"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working || true",
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status waiting || true",
            "type": "command"
          }
        ],
        "matcher": "ToolPermission"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "workmux register-agent || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inactiveMcpServers": {
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~/Projects/"
      ],
      "command": "npx",
      "trust": true
    },
    "git": {
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "command": "uvx",
      "trust": true
    },
    "github": {
      "headers": {
        "Authorization": "Bearer $GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "trust": true
    },
    "gitmcp": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/{owner}/{repo}"
      ],
      "command": "npx"
    },
    "mcp-sequentialthinking-tools": {
      "args": [
        "-y",
        "mcp-sequentialthinking-tools"
      ],
      "command": "npx",
      "env": {
        "MAX_HISTORY_SIZE": "1000"
      }
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx"
    },
    "sequential-thinking": {
      "args": [
        "--from",
        "git+https://github.com/arben-adm/mcp-sequential-thinking",
        "--with",
        "portalocker",
        "mcp-sequential-thinking"
      ],
      "command": "uvx"
    },
    "server-sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    },
    "time": {
      "args": [
        "mcp-server-time"
      ],
      "command": "uvx"
    }
  },
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "command": "npx",
      "trust": true
    },
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "command": "npx",
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "6000"
      },
      "trust": true
    },
    "crash": {
      "args": [
        "-y",
        "crash-mcp"
      ],
      "command": "npx",
      "trust": true
    },
    "fetch": {
      "args": [
        "mcp-server-fetch"
      ],
      "command": "uvx",
      "trust": true
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest",
        "--extension"
      ],
      "command": "npx",
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "$PLAYWRIGHT_MCP_EXTENSION_TOKEN"
      },
      "trust": true
    }
  },
  "model": {
    "name": "gemini-3-flash-preview"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "hideBanner": true,
    "hideTips": true,
    "theme": "Shades Of Purple"
  }
}
