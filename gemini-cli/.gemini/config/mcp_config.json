{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "google-drive": {
      "command": "node",
      "args": [
        "/home/lalitmee/Projects/Personal/Github/google-drive-mcp/dist/index.js"
      ],
      "env": {
        "GOOGLE_DRIVE_OAUTH_CREDENTIALS": "/home/lalitmee/.config/google-drive-mcp/gcp-oauth.keys.json"
      }
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    }
  }
}
