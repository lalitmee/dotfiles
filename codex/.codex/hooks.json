{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status waiting || true",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/lalitmee/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "command -v workmux >/dev/null 2>&1 && workmux register-agent || true",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status done || true",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true",
            "type": "command"
          }
        ]
      }
    ]
  }
}
