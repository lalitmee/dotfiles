#-------------------------------------------------------------------------------
# NOTE: audio {{{
#-------------------------------------------------------------------------------
# Play / Pause audio
XF86AudioPlay
    playerctl play-pause

# Play / Pause audio
ctrl + alt + p
    playerctl play-pause

# Next audio track
XF86AudioNext
    playerctl next

# Previous audio track
XF86AudioPrev
    playerctl previous

# Next audio track
ctrl + shift + period
    playerctl next

# Previous audio track
ctrl + shift + comma
    playerctl previous

# Stop audio playback
XF86AudioStop
    playerctl stop

# Control MPD {prev,next,play,pause}
alt + {h,j,k,l}
    mpc {prev,next,play,pause}
