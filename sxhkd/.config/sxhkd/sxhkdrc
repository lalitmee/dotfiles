#-------------------------------------------------------------------------------
# NOTE: i3 {{{
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# NOTE: workspaces {{{
#-------------------------------------------------------------------------------
# Switch to workspace {1-10}
super + {1-9,0}
    i3-msg workspace {1-9,10}

# Move container to workspace {1-10}
super + shift + {1-9,0}
    i3-msg move container to workspace {1-9,10}

# Switch to workspace {11-19}
control + {1-9}
    i3-msg workspace {11,12,13,14,15,16,17,18,19}

# Move container to workspace {11-19}
control + shift + {1-9}
    i3-msg move container to workspace {11,12,13,14,15,16,17,18,19}

# Move workspace to {left,down,up,right} output
super + ctrl + {h,j,k,l}
    i3-msg move workspace to output {left, down, up, right}

# Move workspace to {left,down,up,right} output
super + ctrl + {Left,Down,Up,Right}
    i3-msg move workspace to output {left, down, up, right}
#}}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# NOTE: reload, restart, exit, kill, suspend and lock {{{
#-------------------------------------------------------------------------------
# Reload i3 configuration
super + r
    i3-msg reload

# Restart i3 in-place
super + shift + r
    i3-msg restart

# Exit i3 session
super + shift + e
    i3-msg exit

# Kill focused window
super + q
    i3-msg kill

# Suspend system
super + shift + period
    systemctl suspend

# Lock screen
super + shift + x
    lockscreen
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# NOTE: toggle layouts {{{
#-------------------------------------------------------------------------------
# Toggle fullscreen
super + f
    i3-msg fullscreen toggle

# Toggle layout (split / tabbed / stacking)
super + e
    i3-msg layout toggle splith splitv tabbed stacking

# Split horizontally
super + v
    i3-msg splith

# Split vertically
super + s
    i3-msg splitv

# Toggle focus mode
super + space
    i3-msg focus mode_toggle

# Toggle floating layout
super + shift + space
    i3fyra --float

# Toggle Zen workspace
super + z
    i3zen --width 98 --height 98 --workspace zen

# Switch to Zen workspace
super + shift + z
    i3-msg workspace zen
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# NOTE: windows {{{
#-------------------------------------------------------------------------------
# Focus window {left,down,up,right}
super + {h,j,k,l}
    i3viswiz {left,down,up,right}

# Focus window {left,down,up,right}
super + {Left,Down,Up,Right}
    i3viswiz {left,down,up,right}

# Move window {left,down,up,right}
super + shift + {h,j,k,l}
    i3flip --move {left,down,up,right}

# Move window {left,down,up,right}
super + shift + {Left,Down,Up,Right}
    i3flip --move {left,down,up,right}

# Focus next window
super + Tab
    i3flip next

# Focus previous window
super + shift + Tab
    i3flip prev

# Resize window left
super + ctrl + shift + h
    i3Kornhe size --speed 50 left

# Resize window down
super + ctrl + shift + j
    i3Kornhe size --speed 50 down

# Resize window up
super + ctrl + shift + k
    i3Kornhe size --speed 50 up

# Resize window right
super + ctrl + shift + l
    i3Kornhe size --speed 50 right
#}}}
