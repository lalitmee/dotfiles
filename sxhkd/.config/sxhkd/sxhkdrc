# Start Pomodoro timer
super + alt + p
   ~/.config/polybar/scripts/pomodoro/main.sh --click-left

# Start Pomodoro break
super + alt + b
   ~/.config/polybar/scripts/pomodoro/main.sh --click-middle

# Toggle Pomodoro pause
super + alt + c
   ~/.config/polybar/scripts/pomodoro/main.sh --click-right

# Add 1 minute to Pomodoro
super + alt + Up
   ~/.config/polybar/scripts/pomodoro/main.sh --add

# Subtract 1 minute from Pomodoro
super + alt + Down
    ~/.config/polybar/scripts/pomodoro/main.sh --sub

# Reset Pomodoro timer
super + alt + r
    ~/.config/polybar/scripts/pomodoro/main.sh --reset

# Start custom work timer (prompt for minutes)
super + alt + w
    WORK_MIN=$(rofi -dmenu -p "Work minutes:" -theme "~/.config/rofi/cheatsheet.rasi" -font "Operator Mono Lig 11") && ~/.config/polybar/scripts/pomodoro/main.sh --start-work $WORK_MIN

