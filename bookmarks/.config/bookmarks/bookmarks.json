{
  "version": 1,
  "bookmarks": [
    {
      "title": "Search Google",
      "url": "https://www.google.com/search?q={input}",
      "prompt": "Search Google"
    },
    {
      "title": "Search YouTube",
      "url": "https://www.youtube.com/results?search_query={input}",
      "prompt": "Search YouTube"
    },
