    },
    "./resource.js": {
      "default": "./resource.js"
    },
    "./resource.mjs": {
      "default": "./resource.mjs"
    },
    "./resources/*.mjs": {
      "default": "./resources/*.mjs"
    },
    "./resources/*.js": {
      "default": "./resources/*.js"
    },
    "./resources/*": {
      "import": "./resources/*.mjs",
