{
  "mcpServers": {
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "crash": {
      "command": "npx",
      "args": [
        "-y",
        "crash-mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    }
  }
}
