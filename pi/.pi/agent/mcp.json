{
  "mcpServers": {
    "vercel": {
      "enabled": true,
      "url": "https://mcp.vercel.com"
    },
    "linear": {
      "enabled": true,
      "url": "https://mcp.linear.app/mcp"
    },
    "context7": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "crash": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "crash-mcp"
      ]
    },
    "chrome-devtools": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "radius": {
      "enabled": true,
      "url": "https://radius.pi.dev/mcp",
      "auth": {
        "provider": "radius"
      }
    }
  }
}
