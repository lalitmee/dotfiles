#!/bin/zsh

# Define configurable variables
border_color="${GUM_STYLE_BORDER_FOREGROUND:-#00AAFF}"  # cobalt2 blue
text_color="${GUM_STYLE_FOREGROUND:-#FFC600}"           # cobalt2 yellow

# Calculate width: use full terminal unless explicit arg given
calculate_width() {
    local width_arg="$1"
    local term_width

    # Use tmux window width when available (handles popups/panes correctly)
    if [[ -n "$TMUX" ]]; then
        term_width=$(tmux display-message -p '#{window_width}' 2>/dev/null || tput cols 2>/dev/null || echo "80")
    else
        term_width=$(tput cols 2>/dev/null || echo "80")
    fi

    if [[ -n "$width_arg" && "$width_arg" =~ ^[0-9]+$ ]]; then
        local max_allowed=$(( term_width - 4 ))
        width=$(( width_arg > max_allowed ? max_allowed : width_arg ))
    else
        width=$(( term_width - 2 ))
    fi

    (( width < 20 )) && width=20
    echo "$width"
}

# Main function to create styled message with rounded border
gum_style() {
    local message="$1"
    local width_arg="$2"
    local quote_color="${3:-$text_color}"

    local width=$(calculate_width "$width_arg")

    # Leading newline ensures box starts below the prompt's second line
    echo ""
    gum style \
        --align center \
        --width "$width" \
        --border rounded \
        --border-foreground "$border_color" \
        --foreground "$quote_color" \
        --margin "0" \
        --padding "1 0" \
        --bold \
        "$message"
}

# Main execution
main() {
    local message="$1"
    local quote_color="${2:-$text_color}"
    local width_arg="$3"

    if [[ -z "$message" ]]; then
        echo "Usage: $0 <message> [width]"
        exit 1
    fi

    gum_style "$message" "$width_arg" "$quote_color"
}

main "$@"
