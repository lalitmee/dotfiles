#!/usr/bin/env zsh
set -euo pipefail

# Interactive git remote browser using fzf (fuzzy search)
# Modes: list, show

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

remote_list() {
    git remote -v | awk '{print $1 "\t" $2}' | uniq |
        fzf --height 50% --no-border --reverse --prompt="Select remote: " \
            --with-nth=1 --delimiter="\t" \
            --preview 'git log --oneline --graph --date=short --pretty="format:%C(auto)%cd %h%d %s" {1} | head -200' |
        cut -f1
}

show_remote() {
    local remote
    remote=$(remote_list)
    if [[ -n "$remote" ]]; then
        echo "Remote: $remote"
        echo "URL: $(git remote get-url "$remote" 2>/dev/null || echo 'not set')"
        echo ""
        echo "Recent commits from $remote/main:"
        git log --oneline --graph "$remote/main" 2>/dev/null | head -20 || echo "No commits found"
    fi
}

main() {
    local mode="${1:-list}"

    if ! command -v fzf &> /dev/null; then
        echo "Error: fzf not found." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    case "$mode" in
        list) remote_list ;;
        show) show_remote ;;
        *)
            echo "Usage: git-remote [list|show]"
            echo "  list  - select a remote (default)"
            echo "  show  - show remote details"
            exit 1
            ;;
    esac
}

main "$@"
