#!/usr/bin/env zsh

# -------------------------------------------------------------------
# Workmux Agent Palette
# -------------------------------------------------------------------
# High-performance, instant-rendering HUD agent launcher palette for workmux.
# Perfectly centered vertically & horizontally in the terminal window,
# styled with distinct non-repeatable colors from cobalt2.nvim per row.
# Uses a static list of coding agents (grok removed). Installed agents are
# brightly highlighted; unavailable agents are dimmed in grey.
#
# Requirements: gum
# -------------------------------------------------------------------

# Ensure child gum subshells preserve truecolor ANSI sequences
export CLICOLOR_FORCE=1
export FORCE_COLOR=1

# -------------------------------------------------------------------
# Configuration {{{
# -------------------------------------------------------------------

# Base UI hex colors from cobalt2.nvim
HEX_ACCENT="#00AAFF"       # blue
HEX_HEADER="#FFC600"       # yellow
HEX_BORDER="#0088FF"       # dark_blue
HEX_INNER_BORDER="#185294" # cursor_hover / deep navy
HEX_MUTED="#9E9E9E"        # light_grey
HEX_DIMMED="#626262"       # dark_grey (uninstalled agents)
HEX_BRACKET="#668799"      # dirty_blue (clear, visible brackets)
HEX_VALUE_WT="#80FCFF"     # light_blue (worktree value)
HEX_VALUE_BR="#3AD900"     # green (branch value)
HEX_KEY="#FFC600"          # yellow

# Static prioritized agent list (grok removed):
# "id|key|mnemonic|label|badge|color"
typeset -ga AGENT_CATALOG=(
    "opencode|1|o|opencode|PRIMARY|#00AAFF"
    "pi|2|p|pi|CORE|#3AD900"
    "agy|3|a|agy|DEEPMIND|#FFC600"
    "codex|4|x|codex|OPENAI|#80FCFF"
    "cursor|5|u|cursor|IDE/CLI|#FF9A00"
    "claude|6|c|claude|ANTHROPIC|#EE80E1"
    "gemini|7|g|gemini|GOOGLE|#967EFB"
    "copilot|8|k|copilot|GITHUB|#88FF88"
    "kiro-cli|9|i|kiro-cli|KIRO|#F2ED7F"
    "vibe|0|v|vibe|MISTRAL|#FF9D00"
    "omp|-|m|omp|OH-MY-PI|#DEEBFE"
)

# Populated by scan_agents
typeset -ga ITEM_IDS=()
typeset -ga ITEM_KEYS=()
typeset -ga ITEM_MNEMONICS=()
typeset -ga ITEM_LABELS=()
typeset -ga ITEM_BADGES=()
typeset -ga ITEM_COLORS=()
typeset -ga ITEM_INSTALLED=()
typeset -ga ITEM_CMDS=()

# Recent launches in this palette session (newest first)
typeset -ga HISTORY_AGENT_IDS=()
typeset -ga HISTORY_LABELS=()
typeset -ga HISTORY_COLORS=()
typeset -ga HISTORY_EXIT_CODES=()
typeset -ga HISTORY_DURATION_SECS=()
typeset -ga HISTORY_END_EPOCHS=()
typeset -ga HISTORY_LAUNCH_KEYS=()

HISTORY_MAX_ROWS=6

# -------------------------------------------------------------------
# }}}
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# ANSI Styling Helpers {{{
# -------------------------------------------------------------------

hex_fg() { # {{{
    local hex="${1#\#}"
    local r=$(( 16#${hex[1,2]} ))
    local g=$(( 16#${hex[3,4]} ))
    local b=$(( 16#${hex[5,6]} ))
    print -r -- "\e[38;2;${r};${g};${b}m"
} # }}}

ANSI_RESET=$'\e[0m'
ANSI_BOLD=$'\e[1m'

# -------------------------------------------------------------------
# }}}
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# Environment & Discovery {{{
# -------------------------------------------------------------------

append_to_path() { # {{{
    local dir="$1"

    if [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]]; then
        export PATH="$dir:$PATH"
    fi
} # }}}

setup_environment() { # {{{
    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
    elif [[ -f "$HOME/.linuxbrew/bin/brew" ]]; then
        eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
    elif [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi

    append_to_path "$HOME/.local/bin"
    append_to_path "$HOME/.config/bin"
    append_to_path "$HOME/.fzf/bin"
    append_to_path "$HOME/.local/share/fnm/aliases/default/bin"
    append_to_path "/opt/homebrew/bin"
    append_to_path "/opt/homebrew/sbin"
    append_to_path "/usr/local/bin"
    append_to_path "/usr/local/sbin"
    append_to_path "/home/linuxbrew/.linuxbrew/bin"
    append_to_path "$HOME/.cargo/bin"

    rehash 2>/dev/null || true
} # }}}

resolve_agent_cmd() { # {{{
    local agent_id="$1"

    case "$agent_id" in
        cursor)
            if command -v cursor-agent > /dev/null 2>&1; then
                print -r -- "cursor-agent"
                return 0
            elif [[ -x "$HOME/.local/bin/agent" ]]; then
                print -r -- "$HOME/.local/bin/agent"
                return 0
            elif command -v cursor > /dev/null 2>&1; then
                print -r -- "cursor agent"
                return 0
            fi
            return 1
            ;;
        *)
            if command -v "$agent_id" > /dev/null 2>&1; then
                print -r -- "$agent_id"
                return 0
            fi
            return 1
            ;;
    esac
} # }}}

scan_agents() { # {{{
    ITEM_IDS=()
    ITEM_KEYS=()
    ITEM_MNEMONICS=()
    ITEM_LABELS=()
    ITEM_BADGES=()
    ITEM_COLORS=()
    ITEM_INSTALLED=()
    ITEM_CMDS=()

    local entry id key mnemonic label badge color cmd

    for entry in "${AGENT_CATALOG[@]}"; do
        IFS='|' read -r id key mnemonic label badge color <<< "$entry"
        ITEM_IDS+=("$id")
        ITEM_KEYS+=("$key")
        ITEM_MNEMONICS+=("$mnemonic")
        ITEM_LABELS+=("$label")
        ITEM_BADGES+=("$badge")
        ITEM_COLORS+=("$color")

        if cmd=$(resolve_agent_cmd "$id"); then
            ITEM_INSTALLED+=("1")
            ITEM_CMDS+=("$cmd")
        else
            ITEM_INSTALLED+=("0")
            ITEM_CMDS+=("")
        fi
    done
} # }}}

# -------------------------------------------------------------------
# }}}
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# Rendering & Geometry {{{
# -------------------------------------------------------------------

get_terminal_geometry() { # {{{
    local cols lines

    if [[ -n "${TMUX:-}" ]]; then
        cols=$(tmux display-message -p '#{pane_width}' 2>/dev/null || tmux display-message -p '#{window_width}' 2>/dev/null || tput cols 2>/dev/null || print -r -- "100")
        lines=$(tmux display-message -p '#{pane_height}' 2>/dev/null || tmux display-message -p '#{window_height}' 2>/dev/null || tput lines 2>/dev/null || print -r -- "30")
    else
        cols=$(tput cols 2>/dev/null || print -r -- "100")
        lines=$(tput lines 2>/dev/null || print -r -- "30")
    fi

    print -r -- "$cols $lines"
} # }}}

format_plain_filter_rows() { # {{{
    local count="${#ITEM_IDS[@]}"
    local i id key mnemonic label badge installed state

    for (( i = 1; i <= count; i++ )); do
        key="${ITEM_KEYS[$i]}"
        mnemonic="${ITEM_MNEMONICS[$i]}"
        label="${ITEM_LABELS[$i]}"
        badge="${ITEM_BADGES[$i]}"
        installed="${ITEM_INSTALLED[$i]}"

        if [[ "$installed" == "1" ]]; then
            state="installed"
        else
            state="not installed"
        fi

        printf "[%s / %s]  %-12s  [%-9s]  (%s)\n" "$key" "$mnemonic" "$label" "$badge" "$state"
    done
} # }}}

center_ansi_text() { # {{{
    local text="$1"
    local visible_len="$2"
    local width="$3"
    local pad=$(( (width - visible_len) / 2 ))
    (( pad < 0 )) && pad=0
    printf "%*s%b" "$pad" "" "$text"
} # }}}

clear_screen_and_scrollback() { # {{{
    if [[ -n "${TMUX:-}" ]]; then
        tmux clear-history 2>/dev/null || true
    fi
    printf '\e[2J\e[H\e[3J'
} # }}}

format_duration_secs() { # {{{
    local secs="$1"

    (( secs < 0 )) && secs=0

    if (( secs >= 3600 )); then
        printf '%dh %02dm' $(( secs / 3600 )) $(( (secs % 3600) / 60 ))
    elif (( secs >= 60 )); then
        printf '%dm %02ds' $(( secs / 60 )) $(( secs % 60 ))
    else
        printf '%ds' "$secs"
    fi
} # }}}

format_exit_result() { # {{{
    local exit_code="$1"

    if (( exit_code == 0 )); then
        print -r -- "ok"
    else
        print -r -- "exit ${exit_code}"
    fi
} # }}}

format_history_end_time() { # {{{
    local epoch="$1"

    if [[ -n "$epoch" && "$epoch" != "0" ]]; then
        date -r "$epoch" "+%H:%M" 2>/dev/null || print -r -- "--:--"
    else
        print -r -- "--:--"
    fi
} # }}}

format_history_launch_key() { # {{{
    local idx="$1"
    local launch_via="${2:-key}"
    local catalog_key="${ITEM_KEYS[$idx]}"
    local mnemonic="${ITEM_MNEMONICS[$idx]}"
    local pair="${catalog_key}/${mnemonic}"

    case "$launch_via" in
        enter)
            print -r -- "↵ ${pair}"
            ;;
        filter)
            print -r -- "/ ${pair}"
            ;;
        *)
            print -r -- "$pair"
            ;;
    esac
} # }}}

record_agent_history() { # {{{
    local agent_id="$1"
    local label="$2"
    local color="$3"
    local exit_code="$4"
    local duration_secs="$5"
    local launch_key="${6:-—}"
    local now_epoch="${EPOCHSECONDS:-$(date +%s)}"

    HISTORY_AGENT_IDS=("$agent_id" "${HISTORY_AGENT_IDS[@]}")
    HISTORY_LABELS=("$label" "${HISTORY_LABELS[@]}")
    HISTORY_COLORS=("$color" "${HISTORY_COLORS[@]}")
    HISTORY_EXIT_CODES=("$exit_code" "${HISTORY_EXIT_CODES[@]}")
    HISTORY_DURATION_SECS=("$duration_secs" "${HISTORY_DURATION_SECS[@]}")
    HISTORY_END_EPOCHS=("${now_epoch}" "${HISTORY_END_EPOCHS[@]}")
    HISTORY_LAUNCH_KEYS=("$launch_key" "${HISTORY_LAUNCH_KEYS[@]}")

    if (( ${#HISTORY_LABELS[@]} > HISTORY_MAX_ROWS )); then
        HISTORY_AGENT_IDS=("${HISTORY_AGENT_IDS[@]:0:$HISTORY_MAX_ROWS}")
        HISTORY_LABELS=("${HISTORY_LABELS[@]:0:$HISTORY_MAX_ROWS}")
        HISTORY_COLORS=("${HISTORY_COLORS[@]:0:$HISTORY_MAX_ROWS}")
        HISTORY_EXIT_CODES=("${HISTORY_EXIT_CODES[@]:0:$HISTORY_MAX_ROWS}")
        HISTORY_DURATION_SECS=("${HISTORY_DURATION_SECS[@]:0:$HISTORY_MAX_ROWS}")
        HISTORY_END_EPOCHS=("${HISTORY_END_EPOCHS[@]:0:$HISTORY_MAX_ROWS}")
        HISTORY_LAUNCH_KEYS=("${HISTORY_LAUNCH_KEYS[@]:0:$HISTORY_MAX_ROWS}")
    fi
} # }}}

format_plain_history_rows() { # {{{
    local count="${#HISTORY_LABELS[@]}"
    local i num launch_key label result duration ended

    if (( count == 0 )); then
        return 0
    fi

    printf "#   Key      Agent       Result     Duration  Ended\n"

    for (( i = 1; i <= count; i++ )); do
        num="$i"
        launch_key="${HISTORY_LAUNCH_KEYS[$i]:-—}"
        label="${HISTORY_LABELS[$i]}"
        result=$(format_exit_result "${HISTORY_EXIT_CODES[$i]}")
        duration=$(format_duration_secs "${HISTORY_DURATION_SECS[$i]}")
        ended=$(format_history_end_time "${HISTORY_END_EPOCHS[$i]}")
        printf "%2d  %-8s  %-11s  %-9s  %-8s  %s\n" "$num" "$launch_key" "$label" "$result" "$duration" "$ended"
    done
} # }}}

build_history_card_content() { # {{{
    local inner_w="$1"
    local count="${#HISTORY_LABELS[@]}"
    local c_header c_muted c_dimmed c_border c_accent c_row c_key
    local header_visible header_line col_header rows_text
    local i num launch_key label result duration ended row_line sep_line
    local -a formatted_rows=()

    if (( count == 0 )); then
        return 0
    fi

    c_header=$(hex_fg "$HEX_HEADER")
    c_muted=$(hex_fg "$HEX_MUTED")
    c_dimmed=$(hex_fg "$HEX_DIMMED")
    c_border=$(hex_fg "$HEX_INNER_BORDER")
    c_accent=$(hex_fg "$HEX_ACCENT")
    c_key=$(hex_fg "$HEX_KEY")

    header_visible="Recent Agent Runs"
    header_line=$(center_ansi_text "${ANSI_BOLD}${c_header}${header_visible}${ANSI_RESET}" "${#header_visible}" "$inner_w")

    col_header=$(printf " %b#%b   %bKey%b      %bAgent%b       %bResult%b     %bDuration%b  %bEnded%b" \
        "$c_muted" "$ANSI_RESET" "$c_muted" "$ANSI_RESET" "$c_muted" "$ANSI_RESET" \
        "$c_muted" "$ANSI_RESET" "$c_muted" "$ANSI_RESET" "$c_muted" "$ANSI_RESET")

    sep_line=$(printf "%b%s%b" "$c_border" "$(printf '─%.0s' {1..$inner_w})" "$ANSI_RESET")

    for (( i = 1; i <= count; i++ )); do
        num="$i"
        launch_key="${HISTORY_LAUNCH_KEYS[$i]:-—}"
        label="${HISTORY_LABELS[$i]}"
        duration=$(format_duration_secs "${HISTORY_DURATION_SECS[$i]}")
        ended=$(format_history_end_time "${HISTORY_END_EPOCHS[$i]}")
        c_row=$(hex_fg "${HISTORY_COLORS[$i]:-$HEX_MUTED}")

        if (( HISTORY_EXIT_CODES[i] == 0 )); then
            result="${ANSI_BOLD}${c_accent}$(format_exit_result "${HISTORY_EXIT_CODES[$i]}")${ANSI_RESET}"
        else
            result="${ANSI_BOLD}${c_row}$(format_exit_result "${HISTORY_EXIT_CODES[$i]}")${ANSI_RESET}"
        fi

        row_line=$(printf " %b%2d%b  %b%-8s%b  %b%-11s%b  %s  %b%-8s%b  %b%s%b" \
            "$c_muted" "$num" "$ANSI_RESET" \
            "$ANSI_BOLD$c_key" "$launch_key" "$ANSI_RESET" \
            "$ANSI_BOLD$c_row" "$label" "$ANSI_RESET" \
            "$result" \
            "$c_dimmed" "$duration" "$ANSI_RESET" \
            "$c_muted" "$ended" "$ANSI_RESET")
        formatted_rows+=("$row_line")
    done

    rows_text=$(printf "%b\n" "${formatted_rows[@]}")
    printf "%b\n%b\n%b\n%b" "$header_line" "$col_header" "$sep_line" "$rows_text"
} # }}}

render_palette() { # {{{
    clear_screen_and_scrollback
    local term_geo
    term_geo=$(get_terminal_geometry)
    local term_cols="${term_geo%% *}"
    local term_lines="${term_geo##* }"

    # Target card geometry
    local card_width=78
    if (( term_cols < 82 )); then
        card_width=$(( term_cols - 4 ))
    fi
    (( card_width < 48 )) && card_width=48

    local inner_w=$(( card_width - 8 ))
    local sep_line
    sep_line=$(printf "─%.0s" {1..$inner_w})

    local worktree_name="${PWD:t}"
    local branch_name
    branch_name=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || print -r -- "detached")

    # Pre-render ANSI color tags
    local c_accent c_header c_border c_bracket c_wt c_br c_muted c_dimmed c_key
    c_accent=$(hex_fg "$HEX_ACCENT")
    c_header=$(hex_fg "$HEX_HEADER")
    c_border=$(hex_fg "$HEX_INNER_BORDER")
    c_bracket=$(hex_fg "$HEX_BRACKET")
    c_wt=$(hex_fg "$HEX_VALUE_WT")
    c_br=$(hex_fg "$HEX_VALUE_BR")
    c_muted=$(hex_fg "$HEX_MUTED")
    c_dimmed=$(hex_fg "$HEX_DIMMED")
    c_key=$(hex_fg "$HEX_KEY")

    # Header section
    local title_visible="Workmux Agent Launcher"
    local sub_visible="Worktree: ${worktree_name}   •   Branch:  ${branch_name}"

    local title_content="${ANSI_BOLD}${c_header}${title_visible}${ANSI_RESET}"
    local sub_content="${c_accent}Worktree: ${ANSI_BOLD}${c_wt}${worktree_name}${ANSI_RESET}   ${c_border}•${ANSI_RESET}   ${c_accent}Branch: ${ANSI_BOLD}${c_br} ${branch_name}${ANSI_RESET}"

    local title_line sub_line header_sep
    title_line=$(center_ansi_text "$title_content" "${#title_visible}" "$inner_w")
    sub_line=$(center_ansi_text "$sub_content" "${#sub_visible}" "$inner_w")
    header_sep="${c_border}${sep_line}${ANSI_RESET}"

    # Agent rows: static list. Installed = colored; Uninstalled = completely dimmed in grey
    local -a formatted_rows=()
    local count="${#ITEM_IDS[@]}"
    local i key mnemonic label badge color installed c_row hint row_str

    for (( i = 1; i <= count; i++ )); do
        key="${ITEM_KEYS[$i]}"
        mnemonic="${ITEM_MNEMONICS[$i]}"
        label="${ITEM_LABELS[$i]}"
        badge="${ITEM_BADGES[$i]}"
        color="${ITEM_COLORS[$i]}"
        installed="${ITEM_INSTALLED[$i]}"

        if [[ "$installed" == "1" ]]; then
            c_row=$(hex_fg "$color")
            hint="press ${key} or ${mnemonic}"
            row_str=$(printf " %b[%b%s%b / %b%s%b]%b     %b%-12s%b        %b[%b%-9s%b]%b         %b%-17s%b" \
                "$c_bracket" "$ANSI_BOLD$c_row" "$key" "$ANSI_RESET$c_bracket" "$ANSI_BOLD$c_row" "$mnemonic" "$ANSI_RESET$c_bracket" "$ANSI_RESET" \
                "$ANSI_BOLD$c_row" "$label" "$ANSI_RESET" \
                "$c_bracket" "$c_row" "$badge" "$ANSI_RESET$c_bracket" "$ANSI_RESET" \
                "$c_row" "$hint" "$ANSI_RESET")
        else
            hint="not installed"
            row_str=$(printf " %b[%s / %s]     %-12s        [%-9s]         %-17s%b" \
                "$c_dimmed" "$key" "$mnemonic" "$label" "$badge" "$hint" "$ANSI_RESET")
        fi

        formatted_rows+=("$row_str")
    done

    local rows_text
    rows_text=$(printf "%b\n" "${formatted_rows[@]}")

    # Footer section: centered with visible text length calculation
    local footer_visible="[1-9,0] Launch  •  [/] Filter  •  [Enter] Default  •  [q] Shell"
    local footer_content=$(printf "  %b[%b1-9,0%b]%b %bLaunch%b  %b•%b  %b[%b/%b]%b %bFilter%b  %b•%b  %b[%bEnter%b]%b %bDefault%b  %b•%b  %b[%bq%b]%b %bShell%b" \
        "$c_bracket" "$ANSI_BOLD$c_key" "$ANSI_RESET$c_bracket" "$ANSI_RESET" "$c_muted" "$ANSI_RESET" \
        "$c_border" "$ANSI_RESET" \
        "$c_bracket" "$ANSI_BOLD$c_accent" "$ANSI_RESET$c_bracket" "$ANSI_RESET" "$c_muted" "$ANSI_RESET" \
        "$c_border" "$ANSI_RESET" \
        "$c_bracket" "$ANSI_BOLD$c_key" "$ANSI_RESET$c_bracket" "$ANSI_RESET" "$c_muted" "$ANSI_RESET" \
        "$c_border" "$ANSI_RESET" \
        "$c_bracket" "$ANSI_BOLD$c_accent" "$ANSI_RESET$c_bracket" "$ANSI_RESET" "$c_muted" "$ANSI_RESET")

    local footer_sep footer_line
    footer_sep="${c_border}${sep_line}${ANSI_RESET}"
    footer_line=$(center_ansi_text "$footer_content" "${#footer_visible}" "$inner_w")

    # Assemble full card content with exactly ONE gum style execution
    local card_content
    card_content=$(printf "%b\n\n%b\n%b\n\n%b\n\n%b\n%b" \
        "$title_line" "$sub_line" "$header_sep" "$rows_text" "$footer_sep" "$footer_line")

    local card_box history_box="" history_content
    card_box=$(gum style \
        --border rounded \
        --border-foreground "$HEX_ACCENT" \
        --bold \
        --padding "1 2" \
        --width "$card_width" \
        "$card_content")

    if (( ${#HISTORY_LABELS[@]} > 0 )); then
        history_content=$(build_history_card_content "$inner_w")
        history_box=$(gum style \
            --border rounded \
            --border-foreground "$HEX_INNER_BORDER" \
            --padding "1 2" \
            --width "$card_width" \
            "$history_content")
    fi

    # Exact vertical centering for launcher card + optional history block:
    local card_line_count history_line_count=0 stack_line_count
    card_line_count=$(print -r -- "$card_box" | wc -l | tr -d ' ')
    if [[ -n "$history_box" ]]; then
        history_line_count=$(print -r -- "$history_box" | wc -l | tr -d ' ')
    fi
    stack_line_count=$(( card_line_count + history_line_count ))
    if [[ -n "$history_box" ]]; then
        stack_line_count=$(( stack_line_count + 1 ))
    fi

    local pad_top=0
    if (( term_lines > stack_line_count )); then
        pad_top=$(( (term_lines - stack_line_count) / 2 ))
    fi

    # Exact horizontal centering margin:
    local margin_h=2
    if (( term_cols > card_width )); then
        margin_h=$(( (term_cols - card_width) / 2 ))
    fi

    # Emit vertical top padding
    for (( i = 1; i <= pad_top; i++ )); do
        print -r -- ""
    done

    # Emit horizontally centered launcher card, then recent runs directly below
    gum style --margin "0 ${margin_h}" "$card_box"
    if [[ -n "$history_box" ]]; then
        gum style --margin "1 ${margin_h}" "$history_box"
    fi
} # }}}

# -------------------------------------------------------------------
# }}}
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# Input & Execution {{{
# -------------------------------------------------------------------

resolve_key_to_agent_index() { # {{{
    local key="${1:l}"
    local count="${#ITEM_IDS[@]}"
    local i

    if [[ -z "$key" ]]; then
        return 1
    fi

    for (( i = 1; i <= count; i++ )); do
        if [[ "${ITEM_KEYS[$i]}" == "$key" && "$key" != "-" ]]; then
            print -r -- "$i"
            return 0
        fi
        if [[ "${ITEM_MNEMONICS[$i]:l}" == "$key" ]]; then
            print -r -- "$i"
            return 0
        fi
    done

    return 1
} # }}}

pick_with_gum_filter() { # {{{
    local selection
    selection=$(format_plain_filter_rows | gum filter \
        --header "Filter & Dispatch Agent" \
        --placeholder "Type agent name or keycap..." \
        --header.foreground "$HEX_HEADER" \
        --indicator.foreground "$HEX_ACCENT" \
        --match.foreground "$HEX_HEADER" \
        --prompt.foreground "$HEX_ACCENT" \
        --height 14) || return 1

    if [[ -z "$selection" ]]; then
        return 1
    fi

    local picked_label
    picked_label=$(print -r -- "$selection" | awk '{print $4}')

    local i count="${#ITEM_IDS[@]}"
    for (( i = 1; i <= count; i++ )); do
        if [[ "${ITEM_LABELS[$i]}" == "$picked_label" ]]; then
            print -r -- "$i"
            return 0
        fi
    done

    return 1
} # }}}

notify_not_installed() { # {{{
    local label="$1"
    if command -v gum > /dev/null 2>&1; then
        gum style \
            --foreground "$HEX_DIMMED" \
            --bold \
            --margin "1 4" \
            "⚠ Agent '${label}' is not installed on this system."
        sleep 1
    else
        print -r -- "⚠ Agent '${label}' is not installed."
        sleep 1
    fi
} # }}}

animate_agent_handoff() { # {{{
    local label="$1"
    local color="${2:-$HEX_ACCENT}"

    if command -v gum > /dev/null 2>&1; then
        local term_geo
        term_geo=$(get_terminal_geometry)
        local term_cols="${term_geo%% *}"
        local term_lines="${term_geo##* }"

        local pad_top=$(( (term_lines - 3) / 2 ))
        (( pad_top < 1 )) && pad_top=1

        local margin_h=$(( (term_cols - 46) / 2 ))
        (( margin_h < 1 )) && margin_h=2

        clear
        for (( i = 1; i <= pad_top; i++ )); do
            print -r -- ""
        done

        gum spin \
            --spinner=pulse \
            --spinner.foreground="$color" \
            --title=" Launching ${label}..." \
            --title.foreground="$color" \
            --align left \
            --margin "0 ${margin_h}" \
            -- sleep 0.45
    else
        print -r -- "▶ Launching: ${label}..."
        sleep 0.2
    fi
} # }}}

launch_agent_by_index() { # {{{
    local idx="$1"
    local launch_via="$2"
    shift 2

    local label="${ITEM_LABELS[$idx]}"
    local cmd="${ITEM_CMDS[$idx]}"
    local color="${ITEM_COLORS[$idx]}"
    local installed="${ITEM_INSTALLED[$idx]}"
    local launch_key_display
    launch_key_display=$(format_history_launch_key "$idx" "$launch_via")

    if [[ "$installed" != "1" || -z "$cmd" ]]; then
        notify_not_installed "$label"
        return 1
    fi

    # Animated progression state
    animate_agent_handoff "$label" "$color"

    if [[ -n "${TMUX:-}" ]]; then
        tmux rename-window "$label" 2>/dev/null || true
    fi

    clear
    local start_epoch="${EPOCHSECONDS:-$(date +%s)}"
    local -a cmd_parts
    cmd_parts=("${(@z)cmd}")
    "${cmd_parts[@]}" "$@"
    local exit_code=$?
    local now_epoch="${EPOCHSECONDS:-$(date +%s)}"
    local duration_secs=$(( now_epoch - start_epoch ))

    record_agent_history "${ITEM_IDS[$idx]}" "$label" "$color" "$exit_code" "$duration_secs" "$launch_key_display"

    rename_agent_window

    return "$exit_code"
} # }}}

rename_agent_window() { # {{{
    if [[ -n "${TMUX:-}" ]]; then
        tmux rename-window "agent" 2>/dev/null || true
    fi
} # }}}

drop_to_shell() { # {{{
    rename_agent_window
    stty sane 2>/dev/null || true
    exec "${SHELL:-/bin/zsh}" -l
} # }}}

read_single_key() { # {{{
    local key="" saved_stty=""

    if [[ -t 0 ]]; then
        saved_stty=$(stty -g 2>/dev/null || true)
        stty -echo 2>/dev/null || true
    fi

    if ! read -r -k 1 key; then
        if [[ -n "$saved_stty" ]]; then
            stty "$saved_stty" 2>/dev/null || stty echo 2>/dev/null || true
        fi
        return 2
    fi

    # Consume trailing escape sequence bytes if Esc or arrow key was pressed
    if [[ "$key" == $'\e' ]]; then
        local rest=""
        while read -r -k 1 -t 0.02 rest 2>/dev/null; do
            key+="$rest"
        done
    fi

    if [[ -n "$saved_stty" ]]; then
        stty "$saved_stty" 2>/dev/null || stty echo 2>/dev/null || true
    fi

    REPLY="$key"
    return 0
} # }}}

capture_palette_key() { # {{{
    local key="" read_status=0
    local xtrace_was_active=0

    if [[ -o xtrace ]]; then
        xtrace_was_active=1
        set +x
    fi

    read_single_key
    read_status=$?
    key="$REPLY"

    if (( xtrace_was_active )); then
        set -x
    fi

    REPLY="$key"
    return "$read_status"
} # }}}

# -------------------------------------------------------------------
# }}}
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# Main Loop {{{
# -------------------------------------------------------------------

main() { # {{{
    setup_environment
    rename_agent_window

    while true; do
        scan_agents

        render_palette
        rename_agent_window

        printf '\e[?25l' >/dev/tty 2>/dev/null || true

        local key read_status=0

        capture_palette_key
        read_status=$?
        key="$REPLY"

        printf '\e[?25h' >/dev/tty 2>/dev/null || true

        if (( read_status == 2 )); then
            clear
            exit 0
        elif (( read_status != 0 )); then
            drop_to_shell
        fi

        case "$key" in
            q|Q)
                clear
                drop_to_shell
                ;;
            $'\n'|$'\r')
                clear
                launch_agent_by_index 1 enter "$@"
                ;;
            /|f|F|:)
                local idx
                if idx=$(pick_with_gum_filter); then
                    clear
                    launch_agent_by_index "$idx" filter "$@"
                fi
                ;;
            *)
                local idx
                if idx=$(resolve_key_to_agent_index "$key"); then
                    clear
                    launch_agent_by_index "$idx" key "$@"
                fi
                ;;
        esac
    done
} # }}}

if [[ "${ZSH_EVAL_CONTEXT:-}" == toplevel ]]; then
    main "$@"
fi

# -------------------------------------------------------------------
# }}}
# -------------------------------------------------------------------
