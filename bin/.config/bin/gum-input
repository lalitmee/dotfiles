#!/usr/bin/env bash
# Shared Cobalt2 input styling. Usage: gum-input input|write [gum flags...]
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/gum-theme.sh"

# {{{ main
main() {
    local mode="${1:-input}"
    [[ $# -gt 0 ]] && shift
    case "$mode" in
        input|write) ;;
        *) printf 'Usage: gum-input input|write [gum flags...]\n' >&2; return 2 ;;
    esac

    local label="$(gum_theme_ansi "$gum_label" '1;')"
    local key="$(gum_theme_ansi "$gum_accent" '1;')"
    local value="$(gum_theme_ansi "$gum_value")"
    local reset=$'\033[0m'
    local header='' hints='' show_help=true
    local decorate_header=true
    local -a args=() styles=()
    if [[ "$mode" == write ]]; then
        header="${GUM_WRITE_HEADER:-}"
        show_help="${GUM_WRITE_SHOW_HELP:-true}"
        styles+=(--base.foreground="$gum_foreground" --base.background="$gum_background")
        hints="${key}Enter${reset}: ${value}submit${reset}   ${key}Ctrl+J${reset}: ${value}newline${reset}   ${key}Ctrl+E${reset}: ${value}editor${reset}"
    else
        header="${GUM_INPUT_HEADER:-}"
        show_help="${GUM_INPUT_SHOW_HELP:-true}"
        hints="${key}Enter${reset}: ${value}submit${reset}"
    fi
    hints+="   ${key}Esc/Ctrl+C${reset}: ${value}cancel${reset}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|-v|--version)
                exec gum "$mode" "$@" ;;
            --header)
                [[ $# -ge 2 ]] || { printf 'Missing --header value\n' >&2; return 2; }
                header="$2"; shift 2 ;;
            --header=*) header="${1#*=}"; shift ;;
            --show-help) show_help=true; shift ;;
            --no-show-help) show_help=false; shift ;;
            --show-help=*) show_help="${1#*=}"; shift ;;
            --header.foreground)
                [[ $# -ge 2 ]] || { printf 'Missing value for %s\n' "$1" >&2; return 2; }
                decorate_header=false; args+=("$1" "$2"); shift 2 ;;
            --header.foreground=*) decorate_header=false; args+=("$1"); shift ;;
            --) args+=("$@"); break ;;
            # Preserve flag values verbatim, even when they look like options.
            --placeholder|--prompt|--value|--width|--height|--char-limit|--max-lines|--timeout|--padding|--cursor.mode|--*.foreground|--*.background)
                [[ $# -ge 2 ]] || { printf 'Missing value for %s\n' "$1" >&2; return 2; }
                args+=("$1" "$2"); shift 2 ;;
            *) args+=("$1"); shift ;;
        esac
    done

    if [[ -n "$header" && "$decorate_header" == true ]]; then
        header="${label}${header}${reset}"
    fi
    if [[ "$show_help" == true || "$show_help" == 1 ]]; then
        [[ -z "$header" ]] || header+=$'\n'
        header+="$hints"
    fi
    # Gum renders its UI on stderr; stdout remains the submitted value only.
    exec gum "$mode" \
        --header.foreground="$gum_label" --header.background="$gum_background" \
        --placeholder.foreground="$gum_muted" --placeholder.background="$gum_background" \
        --prompt.foreground="$gum_accent" --prompt.background="$gum_background" \
        --cursor.foreground="$gum_accent" --cursor.background="$gum_background" \
        "${styles[@]}" --no-show-help --header="$header" "${args[@]}"
}
# }}}

main "$@"
