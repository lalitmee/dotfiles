#!/usr/bin/env zsh
set -euo pipefail

# Interactive git stash utility using fzf (fuzzy search)
# Modes: list, apply, drop

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

no_stash_msg() {
    "${${(%):-%x}:A:h}/gum_style" $'No stashes tucked away.\n\nCreate one with: git stash'
}

stash_list_fzf() {
    local multi=""
    [[ "${1:-}" == "multi" ]] && multi="--multi"
    local stashes
    stashes=$(git stash list)
    if [[ -z "$stashes" ]]; then
        no_stash_msg
        return 1
    fi
    echo "$stashes" |
        fzf --height 50% --no-border --reverse $multi --prompt="Select stash: " \
            --preview 'git stash show -p {} | head -200'
}

for_each_stash() {
    local label="$1" cmd="$2"
    local stash ref
    stash=$(stash_list_fzf "multi")
    [[ -z "$stash" ]] && return 0
    echo "$stash" | while read -r line; do
        [[ -n "$line" ]] && print -r -- "${line%%:*}"
    done | sort -t@ -k2 -nr | while read -r ref; do
        if gum confirm "${label} stash ${ref}?"; then
            git stash "$cmd" "$ref" || echo "Failed to ${label:l} $ref" >&2
        fi
    done
}

apply_stash() { for_each_stash "Apply" pop; }
drop_stash()  { for_each_stash "Drop" drop; }

main() {
    local mode="${1:-list}"

    if ! command -v fzf &> /dev/null || ! command -v gum &> /dev/null; then
        echo "Error: both fzf and gum are required." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    case "$mode" in
        list) stash_list_fzf ;;
        apply) apply_stash ;;
        drop) drop_stash ;;
        *)
            echo "Usage: git-stash [list|apply|drop]"
            echo "  list   - browse stashes (default)"
            echo "  apply  - apply a stash"
            echo "  drop   - drop a stash"
            exit 1
            ;;
    esac
}

main "$@"
