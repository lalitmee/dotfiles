#!/usr/bin/env zsh
set -euo pipefail

# Interactive git stash utility using fzf (fuzzy search)
# Modes: list, apply, drop

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

stash_list_fzf() {
    git stash list |
        fzf --height 50% --no-border --reverse --prompt="Select stash: " \
            --preview 'git stash show -p {} | head -200'
}

apply_stash() {
    local stash
    stash=$(stash_list_fzf)
    if [[ -n "$stash" ]]; then
        local stash_ref
        stash_ref=$(echo "$stash" | cut -d: -f1)
        if gum confirm "Apply stash ${stash_ref}?"; then
            git stash pop "$stash_ref"
        fi
    fi
}

drop_stash() {
    local stash
    stash=$(stash_list_fzf)
    if [[ -n "$stash" ]]; then
        local stash_ref
        stash_ref=$(echo "$stash" | cut -d: -f1)
        if gum confirm "Drop stash ${stash_ref}?"; then
            git stash drop "$stash_ref"
        fi
    fi
}

main() {
    local mode="${1:-list}"

    if ! command -v fzf &> /dev/null || ! command -v gum &> /dev/null; then
        echo "Error: both fzf and gum are required." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    case "$mode" in
        list) stash_list_fzf ;;
        apply) apply_stash ;;
        drop) drop_stash ;;
        *)
            echo "Usage: git-stash [list|apply|drop]"
            echo "  list   - browse stashes (default)"
            echo "  apply  - apply a stash"
            echo "  drop   - drop a stash"
            exit 1
            ;;
    esac
}

main "$@"
