#!/usr/bin/env zsh
set -euo pipefail

# Interactive git status viewer using fzf (fuzzy search)
# Modes: view, stage, diff

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

status_fzf() {
    local mode="${1:-view}"
    local preview='git diff --color=always -- {-1}'

    case "$mode" in
        stage)
            git status --short |
                fzf --height 50% --no-border --reverse --multi --prompt="Select files to stage: " \
                    --preview "$preview" |
                awk '{print $NF}'
            ;;
        diff)
            git status --short |
                fzf --height 50% --no-border --reverse --multi --prompt="Select files to diff: " \
                    --preview "$preview" |
                awk '{print $NF}'
            ;;
        *)
            git status --short |
                fzf --height 50% --no-border --reverse --prompt="Filter changed files: " \
                    --preview "$preview"
            ;;
    esac
}

main() {
    local mode="${1:-view}"

    if ! command -v fzf &> /dev/null; then
        echo "Error: fzf not found." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    local files
    files=$(status_fzf "$mode")

    if [[ -z "$files" ]]; then
        echo "No files selected." >&2
        exit 0
    fi

    case "$mode" in
        stage)
            echo "$files" | while read -r file; do
                [[ -n "$file" ]] && git add "$file"
            done
            echo "Staged $(echo "$files" | wc -l | tr -d ' ') files"
            ;;
        diff)
            echo "$files" | while read -r file; do
                [[ -n "$file" ]] && git diff -- "$file"
            done
            ;;
        *)
            echo "$files"
            ;;
    esac
}

main "$@"
