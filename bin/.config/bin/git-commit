#!/usr/bin/env zsh
set -euo pipefail

# Interactive git commit utility using fzf (fuzzy search)
# Modes: browse (select commit hash), commit (create commit message), amend (amend last commit)

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

browse_commits() {
    git log --oneline -n 50 |
        fzf --height 50% --no-border --reverse --prompt="Select commit: " \
            --preview 'git show --color=always {} | head -200'
}

write_summary() {
    local prompt="$1"
    echo "" | fzf --height 50% --no-border --reverse --prompt="$prompt" \
        --print-query --header="Type and press Enter"
}

write_commit() {
    local summary
    summary=$(write_summary "Summary: ")
    if [[ -n "$summary" ]]; then
        git commit -m "$summary"
    else
        echo "No summary provided. Aborting." >&2
        exit 1
    fi
}

commit_conventional() {
    local commit_types=("feat" "fix" "docs" "style" "refactor" "test" "chore" "revert" "perf" "ci" "build")
    local commit_type scope summary

    commit_type=$(printf '%s\n' "${commit_types[@]}" |
        fzf --height 50% --no-border --reverse --prompt="Select commit type: ")

    if [[ -n "$commit_type" ]]; then
        scope=$(write_summary "Scope (optional): ")
        summary=$(write_summary "Description: ")
        if [[ -n "$summary" ]]; then
            local full_msg
            if [[ -n "$scope" ]]; then
                full_msg="${commit_type}(${scope}): ${summary}"
            else
                full_msg="${commit_type}: ${summary}"
            fi
            git commit -m "$full_msg"
        else
            echo "No summary provided. Aborting." >&2
            exit 1
        fi
    fi
}

require_staged() {
    if ! git diff --cached --quiet; then
        return 0
    fi
    echo "Nothing staged to commit. Use 'git add' or the 'Stage Files' utility first." >&2
    return 1
}

amend_commit() {
    read "CONFIRM?Amend last commit? [y/N] "
    if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
        git commit --amend --no-edit
    fi
}

main() {
    local mode="${1:-browse}"

    if ! command -v fzf &> /dev/null; then
        echo "Error: fzf not found." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    case "$mode" in
        browse) browse_commits ;;
        commit)
            require_staged || return 1
            write_commit
            ;;
        conventional)
            require_staged || return 1
            commit_conventional
            ;;
        amend) amend_commit ;;
        *)
            echo "Usage: git-commit [browse|commit|conventional|amend]"
            echo "  browse        - filter and select a commit hash (default)"
            echo "  commit        - write a commit message interactively"
            echo "  conventional  - write a conventional commit (type(scope): desc)"
            echo "  amend         - amend the last commit"
            exit 1
            ;;
    esac
}

main "$@"
