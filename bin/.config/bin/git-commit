#!/usr/bin/env zsh
set -euo pipefail

# Interactive git commit utility using fzf (fuzzy search)
# Modes: browse (select commit hash), commit (create commit message), amend (amend last commit)

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

no_commits_msg() {
    "${0:A:h}/gum_style" $'No commits yet.\n\nCreate one with: git commit'
}

browse_commits() {
    local commits
    commits=$(git log --pretty=format:'%h%x09%an%x09%cr%x09%s' -n 50)
    if [[ -z "$commits" ]]; then
        no_commits_msg
        return 1
    fi
    echo "$commits" |
        fzf --height 50% --no-border --reverse --prompt="Select commit: " \
            --delimiter="\t" --with-nth=1,2,3,4 \
            --preview 'git show --color=always {1} | head -200'
}

commit_conventional() {
    local commit_types=("feat" "fix" "docs" "style" "refactor" "test" "chore" "revert" "perf" "ci" "build")
    local commit_type scope summary

    commit_type=$(printf '%s\n' "${commit_types[@]}" |
        fzf --height 50% --no-border --reverse --prompt="Select commit type: ")

    if [[ -n "$commit_type" ]]; then
        scope=$(gum input --width 30 --placeholder "scope (optional)")
        summary=$(gum input --width 60 --placeholder "Short description")
        if [[ -n "$summary" ]]; then
            local full_msg
            if [[ -n "$scope" ]]; then
                full_msg="${commit_type}(${scope}): ${summary}"
            else
                full_msg="${commit_type}: ${summary}"
            fi
            local body
            body=$(gum write --width 80 --placeholder "Body (optional)")
            if [[ -n "$body" ]]; then
                git commit -m "$full_msg" -m "$body"
            else
                git commit -m "$full_msg"
            fi
        else
            echo "No summary provided. Aborting." >&2
            exit 1
        fi
    fi
}

require_staged() {
    if ! git diff --cached --quiet; then
        return 0
    fi
    echo "Nothing staged to commit. Use 'git add' or the 'Stage Files' utility first." >&2
    return 1
}

amend_commit() {
    if gum confirm "Amend last commit?"; then
        git commit --amend --no-edit
    fi
}

main() {
    local mode="${1:-browse}"

    if ! command -v fzf &> /dev/null || ! command -v gum &> /dev/null; then
        echo "Error: both fzf and gum are required." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    case "$mode" in
        browse) browse_commits ;;
        commit)
            require_staged || return 1
            commit_conventional
            ;;
        conventional)
            require_staged || return 1
            commit_conventional
            ;;
        amend) amend_commit ;;
        *)
            echo "Usage: git-commit [browse|commit|conventional|amend]"
            echo "  browse        - filter and select a commit hash (default)"
            echo "  commit        - create a conventional commit (type + required summary)"
            echo "  conventional  - alias for commit"
            echo "  amend         - amend the last commit"
            exit 1
            ;;
    esac
}

main "$@"
