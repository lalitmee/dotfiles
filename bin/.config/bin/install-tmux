#!/usr/bin/env zsh

setopt pipefail

typeset -g TMUX_BUILD_DIR=""

message() {
    print -r -- "$1"
}

usage() {
    cat <<'EOF'
Usage: install-tmux [--next|-n | --cleanup-distro | --help|-h]

Build and install the latest stable tmux from source to /usr/local.
Options:
  -n, --next        Build the upstream master branch.
  --cleanup-distro  Interactively remove the distro tmux after verifying
                    the latest /usr/local build.
  -h, --help        Show this help.
EOF
}

get_current_version() {
    local version
    if [[ ! -x /usr/local/bin/tmux ]]; then
        print -r -- none
        return 0
    fi

    version=$(/usr/local/bin/tmux -V 2>/dev/null | awk 'NR == 1 { print $2 }') || return 1
    [[ -n "$version" ]] || return 1
    print -r -- "$version"
}

get_latest_version() {
    local tags
    tags=$(git ls-remote --tags --refs https://github.com/tmux/tmux.git) || return 1
    print -r -- "$tags" |
        awk '$2 ~ /^refs\/tags\/[0-9]+\.[0-9]+[a-z]?$/ { sub("refs/tags/", "", $2); print $2 }' |
        sort -V |
        tail -n 1
}

verify_installed_version() {
    local binary_path="$1"
    local expected="$2"
    local actual

    [[ -x "$binary_path" ]] || return 1
    actual=$("$binary_path" -V 2>/dev/null | awk 'NR == 1 { print $2 }') || return 1
    [[ -n "$actual" && ( -z "$expected" || "$actual" == "$expected" ) ]]
}

cleanup_build_dir() {
    if [[ -n "$TMUX_BUILD_DIR" && -d "$TMUX_BUILD_DIR" ]]; then
        rm -rf -- "$TMUX_BUILD_DIR"
    fi
}

detect_and_install_deps() {
    if [[ "$(uname -s)" == Darwin ]]; then
        command -v brew >/dev/null 2>&1 || {
            message "Homebrew is required: https://brew.sh/" >&2
            return 1
        }
        brew install libevent ncurses pkg-config bison autoconf automake git
    elif command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update && sudo apt-get install -y libevent-dev libncurses-dev build-essential pkg-config bison autoconf automake git
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y libevent-devel ncurses-devel gcc make pkgconfig bison autoconf automake git
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm libevent ncurses gcc make pkg-config bison autoconf automake git
    else
        message "Unsupported OS; install libevent, ncurses, build tools, pkg-config, bison, autoconf, automake, and git." >&2
        return 1
    fi
}

install_from_source() {
    local next="$1"
    local latest_version="$2"
    local version_desc="$latest_version"
    local source_dir stage_dir

    TMUX_BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/tmux-build.XXXXXX") || return 1
    trap cleanup_build_dir EXIT
    source_dir="$TMUX_BUILD_DIR/source"
    stage_dir="$TMUX_BUILD_DIR/stage"

    if [[ "$next" == true ]]; then
        version_desc="upstream master"
        git clone --depth 1 --single-branch --branch master https://github.com/tmux/tmux.git "$source_dir" || return 1
    else
        git clone --depth 1 --single-branch --branch "$latest_version" https://github.com/tmux/tmux.git "$source_dir" || return 1
    fi

    message "Building tmux $version_desc..."
    (cd "$source_dir" && sh autogen.sh) || return 1
    (cd "$source_dir" && ./configure --prefix=/usr/local) || return 1
    (cd "$source_dir" && make) || return 1
    (cd "$source_dir" && make DESTDIR="$stage_dir" install) || return 1

    [[ -f "$stage_dir/usr/local/bin/tmux" && -f "$stage_dir/usr/local/share/man/man1/tmux.1" ]] || {
        message "Build staging did not produce the tmux executable and manual page." >&2
        return 1
    }

    message "Installing tmux files to /usr/local..."
    sudo install -d -m 0755 /usr/local/bin /usr/local/share/man/man1 || return 1
    sudo install -m 0755 "$stage_dir/usr/local/bin/tmux" /usr/local/bin/tmux || return 1
    sudo install -m 0644 "$stage_dir/usr/local/share/man/man1/tmux.1" /usr/local/share/man/man1/tmux.1 || return 1

    if [[ "$next" == true ]]; then
        verify_installed_version /usr/local/bin/tmux "" || {
            message "Installed tmux could not be verified." >&2
            return 1
        }
    else
        verify_installed_version /usr/local/bin/tmux "$latest_version" || {
            message "Installed tmux version does not match $latest_version." >&2
            return 1
        }
    fi

    message "tmux $(get_current_version) installed successfully at /usr/local/bin/tmux"
}

cleanup_distro_package() {
    local current_version latest_version package_status ownership simulation removals answer

    command -v dpkg-query >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1 || {
        message "Distro cleanup is supported only for Debian/Ubuntu packages." >&2
        return 1
    }

    current_version=$(get_current_version) || return 1
    latest_version=$(get_latest_version) || {
        message "Could not determine the latest stable tmux release; leaving packages unchanged." >&2
        return 1
    }
    [[ "$current_version" == "$latest_version" ]] || {
        message "Refusing cleanup: /usr/local tmux is $current_version, latest stable is $latest_version." >&2
        return 1
    }

    package_status=$(dpkg-query -W -f='${Status}' tmux 2>/dev/null) || {
        message "The distro tmux package is not installed."
        return 0
    }
    [[ "$package_status" == "install ok installed" ]] || {
        message "Refusing cleanup: distro tmux package is not fully installed." >&2
        return 1
    }
    ownership=$(dpkg-query -S /usr/bin/tmux 2>/dev/null) || {
        message "Refusing cleanup: dpkg does not own /usr/bin/tmux." >&2
        return 1
    }
    [[ "$ownership" == tmux:\ /usr/bin/tmux ]] || {
        message "Refusing cleanup: /usr/bin/tmux is not owned by the tmux package." >&2
        return 1
    }

    simulation=$(apt-get -s remove tmux) || {
        message "Could not simulate apt removal; leaving packages unchanged." >&2
        return 1
    }
    removals=$(print -r -- "$simulation" | awk '$1 == "Remv" { print $2 }')
    [[ "$removals" == tmux ]] || {
        message "Refusing cleanup: apt would remove packages beyond tmux (or no tmux package)." >&2
        print -r -- "$simulation" >&2
        return 1
    }

    print -r -- "$simulation"
    [[ -r /dev/tty && -w /dev/tty ]] || {
        message "Cleanup requires an interactive terminal; no packages changed." >&2
        return 1
    }
    if ! read -r "answer?Remove the distro tmux package? [y/N] " </dev/tty; then
        message "No confirmation received; no packages changed." >&2
        return 1
    fi
    [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]] || {
        message "Cancelled; no packages changed."
        return 0
    }

    sudo apt-get remove -y tmux
}

main() {
    local next=false cleanup=false current_version latest_version

    case "$#:$1" in
        0:) ;;
        1:-h|1:--help)
            usage
            return 0
            ;;
        1:-n|1:--next)
            next=true
            ;;
        1:--cleanup-distro)
            cleanup=true
            ;;
        *)
            usage >&2
            return 2
            ;;
    esac

    if [[ "$cleanup" == true ]]; then
        cleanup_distro_package
        return $?
    fi

    if [[ "$next" == false ]]; then
        latest_version=$(get_latest_version) || {
            message "Could not determine the latest stable tmux release; no changes made." >&2
            return 1
        }
        [[ -n "$latest_version" ]] || {
            message "No stable tmux release tag was found; no changes made." >&2
            return 1
        }
        current_version=$(get_current_version) || return 1
        if [[ "$current_version" == "$latest_version" ]]; then
            message "tmux is already the latest stable version ($latest_version)."
            return 0
        fi
    else
        latest_version=""
        current_version=$(get_current_version) || return 1
    fi

    detect_and_install_deps || return 1
    message "Installing tmux ${latest_version:-next} (current: $current_version)..."
    install_from_source "$next" "$latest_version"
}

if [[ "${TMUX_INSTALL_SOURCE_ONLY:-0}" != 1 ]]; then
    main "$@"
fi
