#!/usr/bin/env zsh
set -euo pipefail

# Interactive git branch utility using fzf (fuzzy search)
# Modes: switch, delete, checkout-new

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

no_branches_msg() {
    "${0:A:h}/gum_style" $'No branches here yet.\n\nCreate one with: git checkout -b <name>'
}

select_branch() {
    local mode="${1:-switch}"
    local branches

    branches=$(git branch --format="%(refname:short)")
    if [[ -z "$branches" ]]; then
        no_branches_msg
        return 1
    fi

    case "$mode" in
        switch)
            echo "$branches" |
                fzf --height 50% --no-border --reverse --prompt="Switch to branch: " \
                    --preview 'git log -n 1 --color=always --oneline --decorate {}'
            ;;
        delete)
            echo "$branches" |
                fzf --height 50% --no-border --reverse --multi --prompt="Select branches to delete: " \
                    --preview 'git log -n 1 --color=always --oneline --decorate {}'
            ;;
        checkout-new)
            local base
            base=$(echo "$branches" |
                fzf --height 50% --no-border --reverse --prompt="Base branch: " \
                    --preview 'git log -n 1 --color=always --oneline --decorate {}')
            [[ -z "$base" ]] && return 1
            local name
            name=$(gum input --placeholder "New branch name")
            [[ -z "$name" ]] && return 1
            echo "${base}|${name}"
            ;;
    esac
}

main() {
    local mode="${1:-switch}"

    if ! command -v fzf &> /dev/null || ! command -v gum &> /dev/null; then
        echo "Error: both fzf and gum are required." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    local current_branch
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

    case "$mode" in
        switch)
            local branch
            branch=$(select_branch "switch")
            if [[ -n "$branch" ]]; then
                git checkout "$branch"
            fi
            ;;
        delete)
            local branches
            branches=$(select_branch "delete")
            if [[ -n "$branches" ]]; then
                echo "$branches" | while read -r branch; do
                    [[ "$branch" == "$current_branch" ]] && {
                        echo "Skipping current branch: $branch" >&2
                        continue
                    }
                    git branch -D "$branch" 2>/dev/null || echo "Failed to delete: $branch" >&2
                    local upstream remote
                    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "${branch}@{upstream}" 2>/dev/null)
                    if [[ -n "$upstream" && "$upstream" == */* ]]; then
                        remote="${upstream%%/*}"
                        if gum confirm --prompt.foreground="#FFC66D" \
                            "Delete remote branch $remote/$branch too?"; then
                            git push "$remote" --delete "$branch" 2>/dev/null \
                                || echo "Failed to delete remote: $remote/$branch" >&2
                        fi
                    fi
                done
            fi
            ;;
        checkout-new)
            local sel
            sel=$(select_branch "checkout-new")
            if [[ -n "$sel" ]]; then
                local base new_branch
                base="${sel%%|*}"
                new_branch="${sel##*|}"
                git checkout -b "$new_branch" "$base"
            fi
            ;;
        *)
            echo "Usage: git-branch [switch|delete|checkout-new]"
            echo "  switch       - switch to a branch (default)"
            echo "  delete       - delete branches"
            echo "  checkout-new - create and switch to new branch"
            exit 1
            ;;
    esac
}

main "$@"
