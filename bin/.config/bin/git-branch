#!/usr/bin/env zsh
set -euo pipefail

# Interactive git branch utility using fzf (fuzzy search)
# Modes: switch, delete, checkout-new

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

select_branch() {
    local mode="${1:-switch}"

    case "$mode" in
        switch)
            git branch --format="%(refname:short)" |
                fzf --height 50% --no-border --reverse --prompt="Switch to branch: " \
                    --preview 'git log -n 1 --color=always --oneline --decorate {}'
            ;;
        delete)
            git branch --format="%(refname:short)" |
                fzf --height 50% --no-border --reverse --multi --prompt="Select branches to delete: " \
                    --preview 'git log -n 1 --color=always --oneline --decorate {}'
            ;;
        checkout-new)
            print -n "New branch name: "
            read new_branch
            echo "$new_branch"
            ;;
    esac
}

main() {
    local mode="${1:-switch}"

    if ! command -v fzf &> /dev/null; then
        echo "Error: fzf not found." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    local current_branch
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

    case "$mode" in
        switch)
            local branch
            branch=$(select_branch "switch")
            if [[ -n "$branch" ]]; then
                git checkout "$branch"
            fi
            ;;
        delete)
            local branches
            branches=$(select_branch "delete")
            if [[ -n "$branches" ]]; then
                echo "$branches" | while read -r branch; do
                    [[ "$branch" == "$current_branch" ]] && {
                        echo "Skipping current branch: $branch" >&2
                        continue
                    }
                    git branch -D "$branch" 2>/dev/null || echo "Failed to delete: $branch" >&2
                done
            fi
            ;;
        checkout-new)
            local new_branch
            new_branch=$(select_branch "checkout-new")
            if [[ -n "$new_branch" ]]; then
                git checkout -b "$new_branch"
            fi
            ;;
        *)
            echo "Usage: git-branch [switch|delete|checkout-new]"
            echo "  switch       - switch to a branch (default)"
            echo "  delete       - delete branches"
            echo "  checkout-new - create and switch to new branch"
            exit 1
            ;;
    esac
}

main "$@"
