#!/usr/bin/env zsh
set -euo pipefail

# Interactive git tag browser using fzf (fuzzy search)
# Modes: list, show

is_in_git_repo() {
    git rev-parse HEAD > /dev/null 2>&1
}

no_tags_msg() {
    "${0:A:h}/gum_style" $'No tags around here\n\nCreate one with: git tag <name>'
}

tag_list() {
    local tags
    tags=$(git tag --sort="${1:-v:refname}")
    if [[ -z "$tags" ]]; then
        no_tags_msg
        return 1
    fi
    echo "$tags" |
        fzf --height 50% --no-border --reverse --prompt="Select tag: " \
            --preview 'git show --color=always {} | head -200'
}

show_tag() {
    local tag
    tag=$(tag_list)
    if [[ -n "$tag" ]]; then
        git show --stat "$tag"
    fi
}

main() {
    local mode="${1:-list}"

    if ! command -v fzf &> /dev/null || ! command -v gum &> /dev/null; then
        echo "Error: both fzf and gum are required." >&2
        exit 1
    fi

    is_in_git_repo || {
        echo "Error: Not inside a git repository." >&2
        exit 1
    }

    case "$mode" in
        list) tag_list ;;
        show) show_tag ;;
        *)
            echo "Usage: git-tag [list|show]"
            echo "  list  - filter tags (default)"
            echo "  show  - show tag details"
            exit 1
            ;;
    esac
}

main "$@"
