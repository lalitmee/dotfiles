{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["orange", "blue", "green", "cyan", "yellow", "purple", "red"],
    "text": {
      "base": "#FFFFFF",
      "muted": "#9E9E9E",
      "faint": "#808080",
      "action": {
        "primary": { "base": "#0088FF" },
        "secondary": { "base": "#FF9D00" },
        "destructive": { "base": "#FF6B6B" }
      },
      "formfield": { "base": "#80FCFF" },
      "feedback": {
        "error": { "base": "#FF6B6B", "muted": "#902020" },
        "warning": { "base": "#FF9D00", "muted": "#FF9A00" },
        "success": { "base": "#3AD900", "muted": "#2D7067" },
        "info": { "base": "#00D7FF", "muted": "#0050A4" }
      }
    },
    "background": {
      "base": "#193549",
      "raised": { "base": "#0D3A58", "high": "#0E4062", "max": "#185294" },
      "action": {
        "primary": { "base": "#0050A4" },
        "secondary": { "base": "#345FA8" },
        "destructive": { "base": "#441B2F" }
      },
      "formfield": { "base": "#0E4062" },
      "feedback": {
        "error": { "base": "#441B2F" },
        "warning": { "base": "#3A3A3A" },
        "success": { "base": "#1F553A" },
        "info": { "base": "#0E4062" }
      }
    },
    "border": { "base": "#626262" },
    "scrollbar": { "base": "#808080" },
    "diff": {
      "text": { "added": "#3AD900", "removed": "#FF628C", "context": "#808080", "hunkHeader": "#0050A4" },
      "background": { "added": "#1F553A", "removed": "#441B2F", "context": "#0E4062" },
      "highlight": { "added": "#88FF88", "removed": "#FF628C" },
      "lineNumber": { "text": "#9E9E9E", "background": { "added": "#1F553A", "removed": "#441B2F" } }
    },
    "syntax": {
      "comment": "$hue.gray.400",
      "keyword": "$hue.purple.400",
      "function": "$hue.blue.400",
      "variable": "$hue.cyan.400",
      "string": "$hue.green.400",
      "number": "$hue.yellow.400",
      "type": "$hue.blue.600",
      "operator": "$hue.purple.400",
      "punctuation": "$hue.gray.300"
    },
    "markdown": {
      "text": "$hue.gray.100",
      "heading": "$hue.blue.400",
      "link": "$hue.purple.400",
      "linkText": "$hue.cyan.400",
      "code": "$hue.green.400",
      "blockQuote": "$hue.gray.400",
      "emphasis": "$hue.yellow.400",
      "strong": "$hue.yellow.300",
      "horizontalRule": "$hue.gray.400",
      "listItem": "$hue.blue.400",
      "listEnumeration": "$hue.purple.400",
      "image": "$hue.purple.400",
      "imageText": "$hue.cyan.400",
      "codeBlock": "$hue.gray.100"
    }
  },
  "dark": {
    "hue": {
      "gray": { "100": "#CCCCCC", "200": "#BCBCBC", "300": "#9E9E9E", "400": "#808080", "500": "#626262", "600": "#444444", "700": "#3A3A3A", "800": "#1C1C1C", "900": "#0D0D0D" },
      "red": { "100": "#FFA5F3", "200": "#FF628C", "300": "#FF6B6B", "400": "#FF0000", "500": "#902020", "600": "#700009", "700": "#4F0037", "800": "#3B0029", "900": "#28001C" },
      "orange": { "100": "#FFE0A0", "200": "#FFCC6B", "300": "#FFB43B", "400": "#FF9D00", "500": "#FF9A00", "600": "#DE7800", "700": "#AE5100", "800": "#7A3000", "900": "#4A1C00" },
      "yellow": { "100": "#F2ED7F", "200": "#FFEE80", "300": "#FFC600", "400": "#E4B300", "500": "#B99B00", "600": "#8F7600", "700": "#665300", "800": "#403400", "900": "#241D00" },
      "green": { "100": "#BBFFDD", "200": "#9EFF80", "300": "#88FF88", "400": "#3AD900", "500": "#70B950", "600": "#2D7067", "700": "#24594F", "800": "#193F38", "900": "#102B26" },
      "cyan": { "100": "#9EFFFF", "200": "#80FCFF", "300": "#55EFFF", "400": "#00D7FF", "500": "#00AAFF", "600": "#0088AA", "700": "#006477", "800": "#00434F", "900": "#002A33" },
      "blue": { "100": "#80FCFF", "200": "#00AAFF", "300": "#0088FF", "400": "#0050A4", "500": "#0000DF", "600": "#003A75", "700": "#002B58", "800": "#001D3A", "900": "#001124" },
      "purple": { "100": "#DEEBFE", "200": "#BF7CFF", "300": "#9A6DFF", "400": "#967EFB", "500": "#6E58C6", "600": "#4F438F", "700": "#3B326B", "800": "#29234A", "900": "#1A1630" },
      "accent": "$hue.blue",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
