{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.4.2",
    "@dietrichgebert/ponytail@5.3.3",
    "@slkiser/opencode-quota@6.2.2"
  ],
  "agents": {
    "plan": {
      "color": "#FF9D00"
    },
    "build": {
      "color": "#0088FF"
    },
    "discover": {
      "description": "Discover mode — research GitHub repos, topics, or URLs and align on intent",
      "mode": "primary",
      "color": "#3AD900",
      "system": "{file:./prompts/explore-mode.txt}",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "color": "#9EFFFF"
    },
    "general": {
      "color": "#FFEE80"
    },
    "tester": {
      "color": "#00d7ff"
    },
    "refactorer": {
      "color": "#9a6dff"
    },
    "architect": {
      "color": "#ff6b6b"
    },
    "ask": {
      "description": "Ask Mode — read-only workspace interrogation; answers with findings, decisions, logic, and reasons",
      "mode": "primary",
      "color": "#bf7cff",
      "system": "{file:./prompts/ask-mode.txt}",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "providers": {
    "google": {
      "settings": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    }
  },
  "experimental": {
    "todo": true
  },
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mts", ".cts", ".mjs", ".cjs"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    },
    "gopls": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "rust-analyzer": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "lua-language-server": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    }
  },
  "mcp": {
    "servers": {
      "vercel": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "linear": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "context7": {
        "disabled": false,
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp",
          "--api-key",
          "{env:CONTEXT7_API_KEY}"
        ]
      },
      "crash": {
        "disabled": false,
        "type": "local",
        "command": [
          "npx",
          "-y",
          "crash-mcp"
        ]
      },
      "chrome-devtools": {
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ],
        "type": "local"
      }
    }
  },
  "provider": {
    "openai": {}
  }
}
