{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": true,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@tarquinen/opencode-dcp@latest",
    "@dietrichgebert/ponytail"
  ],
  "agent": {
    "plan": {
      "color": "accent",
      "steps": 10
    },
    "build": {
      "color": "primary",
      "steps": 20
    },
    "discover": {
      "description": "Discover mode — research GitHub repos, topics, or URLs and align on intent",
      "mode": "primary",
      "temperature": 0.3,
      "color": "success",
      "prompt": "{file:./prompts/explore-mode.txt}",
      "steps": 10,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "grep": "allow",
        "glob": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "todowrite": "allow"
      }
    },
    "explore": {
      "color": "secondary",
      "steps": 15
    },
    "general": {
      "color": "warning",
      "steps": 15
    },
    "tester": {
      "color": "success",
      "steps": 15
    },
    "refactorer": {
      "color": "primary",
      "steps": 15
    },
    "architect": {
      "color": "accent",
      "steps": 10
    }
  },
  "provider": {
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "6000"
      }
    },
    "crash": {
      "type": "local",
      "command": ["npx", "-y", "crash-mcp"]
    },
    "chrome-devtools": {
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "type": "local"
    }
  }
}
