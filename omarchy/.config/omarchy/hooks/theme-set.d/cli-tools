#!/bin/bash
set -euo pipefail

theme="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
bat_config="${XDG_CONFIG_HOME:-$HOME/.config}/bat"
if command -v bat >/dev/null && [[ -f "$theme/Omarchy.tmTheme" ]]; then
    mkdir -p "$bat_config/themes"
    target="$bat_config/themes/Omarchy.tmTheme"
    if [[ -e "$target" && ! -L "$target" ]]; then
        echo "Refusing to overwrite $target" >&2
        exit 1
    fi
    ln -sfn "$theme/Omarchy.tmTheme" "$target"
    bat cache --build >/dev/null
fi

# Do not start a server just to apply colors. The config loads it on next start.
if command -v tmux >/dev/null && tmux list-sessions >/dev/null 2>&1 && [[ -f "$theme/tmux.conf" ]]; then
    tmux source-file "$theme/tmux.conf"
    if tmux show-option -gqv @dotfiles-tmux | grep -qx on && [[ -f "$theme/tmux-personal.conf" ]]; then
        tmux source-file "$theme/tmux-personal.conf"
    fi
fi

# Sync active theme colors to Antigravity CLI / UI
agy_state="${HOME}/.gemini/antigravity-cli/jetski_state.pbtxt"
if [[ -f "$agy_state" && -f "$theme/pi.json" ]] && command -v python3 >/dev/null; then
    python3 -c "
import json, re, os
state_file = os.path.expanduser('$agy_state')
pi_file = os.path.expanduser('$theme/pi.json')
if os.path.exists(state_file) and os.path.exists(pi_file):
    with open(pi_file) as f:
        pi = json.load(f)
    v = pi.get('vars', {})
    bg = v.get('background', '#193549')
    primary = v.get('accent', '#ffc600')
    fg = v.get('foreground', '#ffffff')
    code_fg = v.get('color6', '#80fcff')
    with open(state_file, 'r') as f:
        content = f.read()
    content = re.sub(r'theme_mode:\s*\w+\n?', '', content)
    content = re.sub(r'custom_theme_seeds_dark\s*:\s*\{[^}]*\}\n?', '', content)
    new_block = f'''theme_mode: THEME_MODE_DARK
custom_theme_seeds_dark: {{
  background: \"{bg}\"
  primary: \"{primary}\"
  foreground_override: \"{fg}\"
  primary_foreground_override: \"{bg}\"
  code_foreground_override: \"{code_fg}\"
}}
'''
    content = content.rstrip() + '\n' + new_block
    with open(state_file, 'w') as f:
        f.write(content)
" 2>/dev/null || true
fi
