  background-color: {to_rgba(p["highlight_fg"], 0.14)} !important;
  color: {p["highlight_fg"]} !important;
}}
"""


def write_vivaldi_zip(p: dict[str, str], theme_name: str, out_zip: Path) -> None:
    """Write a native Vivaldi importable .zip theme package."""
    settings = {
        "colors": {
            "accentBg": p["accent_bg"],
            "baseBg": p["bg"],
            "baseFg": p["fg"],
            "highlightBg": p["highlight_bg"],
        },
        "name": f"Omarchy - {theme_name}",
        "settings": {
            "accentFromPage": False,
            "accentOnWindow": True,
            "borderRadius": "4",
            "tabsTransparent": False,
        },
        "version": 0.1,
    }
    out_zip.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(out_zip, "w", compression=zipfile.ZIP_DEFLATED) as zf:
        zf.writestr("settings.json", json.dumps(settings, indent=2) + "\n")


def main() -> int:
    state_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    theme_dir = state_dir / "omarchy/current/theme"
    colors_path = theme_dir / "colors.toml"

    if not colors_path.is_file():
        return 0

    theme_name = sys.argv[1] if len(sys.argv) > 1 else "current"
    name_file = state_dir / "omarchy/current/theme.name"
    if theme_name == "current" and name_file.is_file():
        theme_name = name_file.read_text(encoding="utf-8").strip() or "current"

    with colors_path.open("rb") as f:
        colors = tomllib.load(f)

    palette = build_palette(colors)

    vivaldi_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "vivaldi"
    css_path = vivaldi_dir / "custom-css/omarchy-theme.css"
    css_path.parent.mkdir(parents=True, exist_ok=True)
    css_path.write_text(render_css(palette, theme_name), encoding="utf-8")

    zip_path = vivaldi_dir / "omarchy-theme.zip"
    write_vivaldi_zip(palette, theme_name, zip_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
