#!/usr/bin/env python3
"""Omarchy theme-set hook: generate Vivaldi Custom CSS and native .zip theme from colors.toml."""

import json
import os
import sys
import tomllib
import zipfile
from pathlib import Path


def parse_hex(color: str) -> tuple[int, int, int]:
    """Parse #RRGGBB or #RGB hex string into (r, g, b)."""
    c = color.strip().lstrip("#")
    if len(c) == 3:
        c = "".join(ch * 2 for ch in c)
    return int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16)


def to_hex(rgb: tuple[int, int, int]) -> str:
    """Format (r, g, b) tuple as #rrggbb."""
    r, g, b = (max(0, min(255, round(v))) for v in rgb)
    return f"#{r:02x}{g:02x}{b:02x}"


def to_rgba(color: str, alpha: float) -> str:
    """Format #RRGGBB color with alpha as rgba(r, g, b, a)."""
    r, g, b = parse_hex(color)
    return f"rgba({r}, {g}, {b}, {alpha:.2f})"


def mix(c1: str, c2: str, t: float) -> str:
    """Linearly interpolate between c1 (t=0) and c2 (t=1)."""
    r1, g1, b1 = parse_hex(c1)
    r2, g2, b2 = parse_hex(c2)
    return to_hex((r1 + (r2 - r1) * t, g1 + (g2 - g1) * t, b1 + (b2 - b1) * t))


def luminance(color: str) -> float:
    """Compute WCAG relative luminance in [0, 1]."""
    def channel(c: int) -> float:
        s = c / 255.0
        return s / 12.92 if s <= 0.03928 else ((s + 0.055) / 1.055) ** 2.4

    r, g, b = parse_hex(color)
    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b)


def contrast_fg(bg: str, dark: str, light: str) -> str:
    """Pick dark or light foreground with higher contrast against bg."""
    lum_bg = luminance(bg)
    c_dark = (max(lum_bg, luminance(dark)) + 0.05) / (min(lum_bg, luminance(dark)) + 0.05)
    c_light = (max(lum_bg, luminance(light)) + 0.05) / (min(lum_bg, luminance(light)) + 0.05)
    return dark if c_dark >= c_light else light


def build_palette(colors: dict) -> dict[str, str]:
    """Normalize Omarchy colors.toml into a full Vivaldi color palette."""
    bg = colors.get("background", "#193549")
    fg = colors.get("foreground", "#ffffff")
    accent = colors.get("accent", "#ffc600")
    mode = colors.get("mode") or ("light" if luminance(bg) > 0.4 else "dark")
    is_dark = mode == "dark"

    dark_anchor = "#000000" if is_dark else "#ffffff"
    light_anchor = "#ffffff" if is_dark else "#000000"

    bg_dark = colors.get("dark_background") or mix(bg, dark_anchor, 0.20)
    bg_darker = colors.get("darker_background") or mix(bg, dark_anchor, 0.35)
    bg_light = colors.get("lighter_background") or mix(bg, light_anchor, 0.12)
    bg_lighter = mix(bg_light, light_anchor, 0.12)

    fg_faded = colors.get("light_foreground") or mix(fg, bg, 0.25)
    fg_dark = colors.get("dark_foreground") or mix(fg, bg, 0.45)

    selection = colors.get("selection") or mix(bg, accent, 0.25)
    highlight_fg = contrast_fg(accent, bg_darker, "#ffffff")
    accent_fg = contrast_fg(bg_dark, bg_darker, fg)

    red = colors.get("red", "#ff628c")
    green = colors.get("green", "#3ad900")
    yellow = colors.get("yellow", accent)
    orange = colors.get("orange", yellow)

    return {
        "mode": mode,
        "bg": bg,
        "bg_dark": bg_dark,
        "bg_darker": bg_darker,
        "bg_light": bg_light,
        "bg_lighter": bg_lighter,
        "bg_intense": mix(bg, light_anchor, 0.08),
        "bg_intenser": mix(bg, light_anchor, 0.16),
        "bg_faded": mix(bg, fg, 0.06),
        "bg_inverse": fg,
        "bg_inverser": fg_faded,
        "fg": fg,
        "fg_intense": colors.get("bright_foreground", fg),
        "fg_faded": fg_faded,
        "fg_faded_more": fg_dark,
        "fg_faded_most": mix(fg, bg, 0.65),
        "fg_dark": fg_dark,
        "accent_bg": bg_dark,
        "accent_bg_dark": bg_darker,
        "accent_bg_darker": mix(bg_darker, dark_anchor, 0.20),
        "accent_bg_faded": selection,
        "accent_fg": accent_fg,
        "highlight_bg": accent,
        "highlight_bg_dark": mix(accent, dark_anchor, 0.15),
        "highlight_bg_faded": mix(accent, bg, 0.30),
        "highlight_fg": highlight_fg,
        "border": mix(bg, fg, 0.14),
        "border_subtle": mix(bg, fg, 0.08),
        "border_intense": mix(bg, fg, 0.24),
        "border_disabled": mix(bg, fg, 0.05),
        "red": red,
        "red_fg": contrast_fg(red, "#102331", "#ffffff"),
        "green": green,
        "green_fg": contrast_fg(green, "#102331", "#ffffff"),
        "warning": orange,
        "warning_fg": contrast_fg(orange, "#102331", "#ffffff"),
    }


