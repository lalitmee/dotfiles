# gitignore for neovim
**/tags*
**/.netrwhist
**/pythonpath.vim
**/nodepath.vim
**/autoload/plugged/*
**/vimspector-config/*
**/paths.vim
**/session
**/wiki/
**/lua-language-server/
**/pack/
**/nvim/undodir/
**/.vim/undo/
**/.vim/tmp/
.log
**/.mind/

# Whisper Python virtual environment
.whisper-venv/
__pycache__/

# Python virtual environments
**/*venv/

# copyq sensitive/runtime files
copyq/.config/copyq/copyq_tab_*.dat
copyq/.config/copyq/copyq.lock
copyq/.config/copyq/copyq_geometry.ini
copyq/.config/copyq/copyq-monitor.ini
copyq/.config/copyq/copyq-filter.ini
copyq/.config/copyq/copyq.pub
copyq/.config/copyq/copyq_tabs.ini

.DS_Store
**/.DS_Store

# Emacs compiled bytecode
*.elc
**/*.elc

# git filter-repo backups
.git-rewrite/

# superpowers agent artifacts
.superpowers/

# secrets and credentials - never commit
.env
.env.*
.envrc
.netrc
.npmrc
*.pem
*.key
id_rsa
id_ed25519
.aws/
secrets.yaml
secrets.yml
.secrets
credentials.json
gh/.config/gh/hosts.yml

# runtime artifacts - shell history, logs, session transcripts
*.log
**/history.txt
session-*.md
