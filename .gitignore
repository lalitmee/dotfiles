# gitignore for neovim

# Personal MCP configuration (keep locally, never version)
codex/.codex/config.toml
opencode/.config/opencode/opencode.json
vscode/mcp.json
.cursor/mcp.json
cursor/.config/cursor/mcp.json

**/tags*
**/.netrwhist
**/pythonpath.vim
**/nodepath.vim
**/autoload/plugged/*
**/vimspector-config/*
**/paths.vim
**/session
**/wiki/
**/lua-language-server/
**/pack/
**/nvim/undodir/
**/.vim/undo/
**/.vim/tmp/
.log
**/.mind/

# Whisper Python virtual environment
.whisper-venv/
__pycache__/
