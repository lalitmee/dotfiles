# custom-shader = shaders/cursor_smear_fade.glsl

shell-integration = zsh
shell-integration-features = no-cursor

cursor-style = block

background = #193549
background-opacity = 0.7
background-blur-radius = 20
# theme = Cobalt2
adjust-cell-width = 0
adjust-cell-height = 2

# font-family = IoskeleyMonoTerm Nerd Font Medium
font-family = MonoLisa Nerd Font
# font-family = IoskeleyMonoTerm Nerd Font SemiCondensed
# font-family = Operator Mono Lig
# font-family = FiraCode Nerd Font Mono
# font-family = BlexMono Nerd Font Mono
# font-family = JetBrainsMono Nerd Font
# font-family = Iosevka Nerd Font
# Shared fallback; set each machine's size in config.local.
font-size = 10

gtk-titlebar = false
gtk-tabs-location = bottom
gtk-wide-tabs = false

window-padding-x = 11
window-padding-y = 11

confirm-close-surface = false

# Keybinds
keybind = super+r=reload_config

#-------------------------------------------------------------------------------
# # NOTE: auto update {{{
#-------------------------------------------------------------------------------

auto-update-channel = stable
auto-update = download

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# # NOTE: local config files {{{
#-------------------------------------------------------------------------------

# linux - omarchy based
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# macos
config-file = ?config.local

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# # NOTE: macos configs {{{
#-------------------------------------------------------------------------------

macos-titlebar-style = hidden
# macos-titlebar-style = transparent

# Map the Option key to Alt (Meta)
macos-option-as-alt = true

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

