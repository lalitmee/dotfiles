bind-key -T work-sessions l display-popup -E -w 80% -h 80% "~/.config/tmux/scripts/work-sessions/work-sessions.sh --list"

# Kill a work session
bind-key -T work-sessions k display-popup -E -w 80% -h 80% "~/.config/tmux/scripts/work-sessions/work-sessions.sh --kill"

