#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: 3. KEYBINDINGS {{{
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Global Bindings (No Prefix) {{{
#           For bindings that work everywhere without the tmux prefix.
#-------------------------------------------------------------------------------

# switch sessions using `Alt-[` and `Alt-]`
bind-key -n M-[ switch-client -p
bind-key -n M-] switch-client -n

# Smart pane switching with awareness of Vim/Neovim splits.
# Smart pane switching with awareness of Vim/Neovim splits.
# Navigate left - send to vim if vim is running, otherwise navigate panes
bind -n 'C-h' if-shell "ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?((n?vim|vim|view|nvim|vimdiff|nvimdiff)(diff)?)$'" 'send-keys C-h' 'select-pane -L'

# Navigate down - send to vim if vim is running, otherwise navigate panes
bind -n 'C-j' if-shell "ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?((n?vim|vim|view|nvim|vimdiff|nvimdiff)(diff)?)$'" 'send-keys C-j' 'select-pane -D'

# Navigate up - send to vim if vim is running, otherwise navigate panes
bind -n 'C-k' if-shell "ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?((n?vim|vim|view|nvim|vimdiff|nvimdiff)(diff)?)$'" 'send-keys C-k' 'select-pane -U'

# Navigate right - send to vim if vim is running, otherwise navigate panes
bind -n 'C-l' if-shell "ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?((n?vim|vim|view|nvim|vimdiff|nvimdiff)(diff)?)$'" 'send-keys C-l' 'select-pane -R'

# Fallbacks to send raw ctrl keys to the active pane after pressing prefix
bind C-h send-keys C-h
bind C-j send-keys C-j
bind C-k send-keys C-k
bind C-l send-keys C-l

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Prefix Mode {{{
#           Parent block for all C-a prefix keybindings.
#           These bindings are triggered after pressing the tmux prefix (C-a).
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Prefix - Window & Pane Management {{{
#           Core window and pane creation, manipulation, and destruction.
#-------------------------------------------------------------------------------

# Create a new window in the same directory as the current pane.
bind c new-window -c '#{pane_current_path}'

# Split the current pane horizontally.
bind '-' split-window -v -c '#{pane_current_path}'

# Split the current pane vertically.
bind '\' split-window -h -c '#{pane_current_path}'

# Kill the current pane without confirmation.
bind x kill-pane

# Move the current pane to its own new window.
bind n break-pane -d

# Prompt to join a pane from another window/session.
bind j command-prompt -p "join pane from: "  "join-pane -h -s '%%'"

# Prompt to swap the current pane with another.
bind q display-panes\; command-prompt -p "pane #: "  "swap-pane -t '%%'"

# Kill the entire current session.
bind X run-shell 'tmux switch-client -n \; kill-session -t "$(tmux display-message -p "#S")" || tmux kill-session'

# tmux 3.8 built-in floating-pane window switcher (default prefix+Tab / S-Tab).
# Re-bound here so the floating pane uses the Cobalt2 popup colours instead of the
# tmux defaults (tmux does not style new-pane from popup-style/popup-border-style).
bind Tab new-pane -E -s "fg=#FFFFFF,bg=#193549" -S "fg=#00AAFF,bg=#193549" -R "fg=#0050A4,bg=#193549" -X 0 -Y 0 -x "75%" -y "30%" \; move-pane -P bottom-centre \; switch-mode -kw
bind BTab new-pane -E -s "fg=#FFFFFF,bg=#193549" -S "fg=#00AAFF,bg=#193549" -R "fg=#0050A4,bg=#193549" -X 0 -Y 0 -x "75%" -y "30%" \; move-pane -P bottom-centre \; switch-mode -ks

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Prefix - Script Launchers {{{
#           Launch various helper scripts and tools.
#-------------------------------------------------------------------------------

# Launch lazygit in a popup (tpad with per-directory git-root detection).
bind g run-shell "#{@tpad-path} toggle lazygit"

# Launch lazydocker in a custom tpad.
bind D run-shell "#{@tpad-path} toggle lazydocker"

# Launch the gh-dash popup script in tpad.
bind G run-shell "#{@tpad-path} toggle gh-dash"

# Launch the process viewer in a popup.
bind p run-shell "#{@tpad-path} toggle process-viewer"

# Launch the main grimoire scratchpad (Replacing tmux-grimoire key bindings)
bind t run-shell "#{@tpad-path} toggle grimoire"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Prefix - Help & Information {{{
#           Help systems and information displays.
#-------------------------------------------------------------------------------

# Launch the keybinding search script (original function)
bind-key -r ? run-shell "~/.config/tmux/scripts/popup/search-keybindings.sh"

# Global help popup
bind / run-shell "$HOME/.config/tmux/scripts/popup/help/help.sh global"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Prefix - Session Management {{{
#           Session creation, switching, and management tools.
#-------------------------------------------------------------------------------

# Launch a script for session management (e.g., tmux-sessionizer).
bind N run-shell "tmux neww ~/.config/tmux/scripts/tmux-sessionizer.sh"

# Launch a script for tmuxinator session management.
bind U run-shell "tmux neww ~/.config/tmux/scripts/tmuxinator-sessionizer.sh"

# Auto-enable the wide sesh popup on the home machine (matches the nvim HOME check).
if-shell '[ "$HOME" = "/home/lalitmee" ]' 'set-option -g @sesh-wide on'

# Launch fzf-based sesh script. Wider popup when grid is portrait or @sesh-wide is on.
bind "o" if-shell '[ "#{@sesh-wide}" = "on" ] || [ "#{pane_width}" -lt "#{pane_height}" ]' 'display-popup -E -w 90% -h 70% "~/.config/tmux/scripts/sesh/fzf.sh"' 'display-popup -E -w 50% -h 70% "~/.config/tmux/scripts/sesh/fzf.sh"'

# Launch gum-based sesh script in a popup. Wider popup when grid is portrait or @sesh-wide is on.
bind "C-o" if-shell '[ "#{@sesh-wide}" = "on" ] || [ "#{pane_width}" -lt "#{pane_height}" ]' 'display-popup -E -w 90% -h 70% "~/.config/tmux/scripts/sesh/gum.sh"' 'display-popup -E -w 50% -h 70% "~/.config/tmux/scripts/sesh/gum.sh"'

# Connect to the last session.
bind "S" run-shell "sesh last"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: File Picker Mode {{{
#           Parent block for all file picker functionality.
#           Enter file picker mode by pressing C-a C-f.
#-------------------------------------------------------------------------------

# File picker mode trigger
bind-key C-f switch-client -T file-picker-mode

#-------------------------------------------------------------------------------
# --- NOTE: File Picker - Keybindings {{{
#-------------------------------------------------------------------------------

# Default file picker
bind-key -T file-picker-mode f display-popup -h 80% -w 80% -E "tmux-file-picker"

# AI docs picker (markdown files from configured folders)
bind-key -T file-picker-mode d display-popup -h 90% -w 90% -E \
    "$HOME/.config/tmux/scripts/ai-docs-picker.sh"

# Git root
bind-key -T file-picker-mode g display-popup -h 80% -w 80% -E "tmux-file-picker -g"

# Zoxide
bind-key -T file-picker-mode z display-popup -h 80% -w 80% -E "tmux-file-picker --zoxide"

# Zoxide (directory only)
bind-key -T file-picker-mode v display-popup -h 80% -w 80% -E "tmux-file-picker --zoxide --dir-only"

# Zoxide (git root)
bind-key -T file-picker-mode x display-popup -h 80% -w 80% -E "tmux-file-picker --zoxide --git-root"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# --- NOTE: File Picker - Help & Navigation {{{
#-------------------------------------------------------------------------------

# Help for file picker mode
bind -T file-picker-mode ? run-shell "$HOME/.config/tmux/scripts/popup/help/help.sh file-picker-mode"

# Exit file picker mode
bind-key -T file-picker-mode q switch-client -T root

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# }}}\
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Ask Mode {{{
#           Parent block for all ask-tools functionality.
#           Enter ask-tools mode by pressing C-a A.
#-------------------------------------------------------------------------------

# Ask-tools mode trigger - Enter ask-tools mode by pressing C-a A
bind-key A switch-client -T ask-tools


#-------------------------------------------------------------------------------
# --- NOTE: Ask - AI Interactions {{{
#           AI-powered conversation and assistance tools.
#-------------------------------------------------------------------------------

# AI ask - main AI interaction
bind-key -T ask-tools a display-popup -w 85% -h 85% -E "zsh -lc '~/.config/tmux/scripts/ask-sh/ask.sh ai'"

# AI chat - interactive AI conversation
bind-key -T ask-tools c display-popup -w 80% -h 70% -E "zsh -lc '~/.config/tmux/scripts/ask-sh/ask.sh ai-chat'"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Ask - Search Operations {{{
#           Web and site search functionality.
#-------------------------------------------------------------------------------

# Site search - search within specific websites
bind-key -T ask-tools s display-popup -w 85% -h 85% -E "zsh -lc '~/.config/tmux/scripts/ask-sh/ask.sh site'"

# Web search - general web search
bind-key -T ask-tools / display-popup -w 85% -h 85% -E "zsh -lc '~/.config/tmux/scripts/ask-sh/ask.sh search'"

# Ducky search - opens top result in browser
bind-key -T ask-tools d display-popup -w 85% -h 85% -E "zsh -lc '~/.config/tmux/scripts/ask-sh/ask.sh ducky'"

# Bang search - browser !bang search
bind-key -T ask-tools b display-popup -w 85% -h 85% -E "zsh -lc '~/.config/tmux/scripts/ask-sh/ask.sh bang'"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Ask - Help & Navigation {{{
#           Help system and table navigation.
#-------------------------------------------------------------------------------

# Help for ask-tools
bind -T ask-tools ? run-shell "$HOME/.config/tmux/scripts/popup/help/help.sh ask-tools"

# Exit the ask-tools table
bind-key -T ask-tools q switch-client -T root

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: AI Mode {{{
#           Parent block for all AI tools functionality.
#           Enter AI tools mode by pressing C-a C-i.
#-------------------------------------------------------------------------------

# AI tools mode trigger - Enter AI tools mode by pressing C-a C-i
bind-key C-i switch-client -T ai-tools


#-------------------------------------------------------------------------------
# --- NOTE: AI - AI Assistants {{{
#           Direct access to various AI assistant tools.
#-------------------------------------------------------------------------------

# Antigravity
bind-key -T ai-tools a display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh agy"

# OpenCode
bind-key -T ai-tools o display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh opencode"

# Claude
bind-key -T ai-tools c display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh claude"

# Codex
bind-key -T ai-tools x display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh codex"


# Crush
bind-key -T ai-tools s display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh crush"

# Kiro
bind-key -T ai-tools k display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh kiro"

# Grok CLI
bind-key -T ai-tools r display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh grok"

# Pi Agent
bind-key -T ai-tools p display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh pi"

# GitHub Copilot
bind-key -T ai-tools h display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh copilot"

# Cursor Agent
bind-key -T ai-tools g display-popup -w 85% -h 85% -E "~/.config/tmux/scripts/popup/ai/tool.sh cursor-agent"

#-------------------------------------------------------------------------------
# }}}
