# Native tmux configuration; settings here no longer depend on OMT's shell parser.

# increase history size
set -g history-limit 10000

# start with mouse mode enabled
set -g mouse on

# enable extended keys (kitty keyboard protocol / modified Enter keys)
set -g extended-keys on
set -g extended-keys-format csi-u

# force Vi mode
#   really you should export VISUAL or EDITOR environment variable, see manual
#set -g status-keys vi
#set -g mode-keys vi

# replace C-b by C-a instead of using both prefixes
# set -gu prefix2
# unbind C-a
# unbind C-b
# set -g prefix C-a
# bind C-a send-prefix

# move status line to top

# -- TPM -----------------------------------------------------------------------

# Plugin declarations are initialized by tmux/.config/tmux/tmux.conf after this file loads.
# Plugin updates remain explicit; config reload never installs or updates them.

# to enable a plugin, use the 'set -g @plugin' syntax:
# visit https://github.com/tmux-plugins for available plugins
#set -g @plugin 'tmux-plugins/tmux-copycat'
#set -g @plugin 'tmux-plugins/tmux-cpu'
#set -g @plugin 'tmux-plugins/tmux-resurrect'
#set -g @plugin 'tmux-plugins/tmux-continuum'
#set -g @continuum-restore 'on'

# Set the prefix to C-a, which is more accessible than C-b.
set -g prefix C-a
set -g prefix2 C-a

# Unbind the default C-b prefix.
unbind C-b

# Allow sending C-a to applications by pressing it twice.
bind C-a send-prefix

# Keep the standard window and pane creation keys in the active pane's path.
bind '"' split-window -v -c '#{pane_current_path}'
bind % split-window -h -c '#{pane_current_path}'

# Restore OMT's effective prefix bindings using native tmux commands.
bind + resize-pane -Z
bind _ split-window -h -c '#{pane_current_path}'
bind b list-buffers
bind C-c new-session
bind -r C-S-H swap-window -t -1 \; select-window -t -1
bind -r C-S-L swap-window -t +1 \; select-window -t +1
bind Enter copy-mode
bind -r l select-pane -R
bind -r L resize-pane -R 2
bind -r h select-pane -L
bind -r H resize-pane -L 2
bind -r k select-pane -U
bind -r K resize-pane -U 2
bind P choose-buffer
bind m if-shell -F '#{mouse}' 'set -g mouse off' 'set -g mouse on'
bind r source-file ~/.config/tmux/tmux.conf \; display-message '~/.config/tmux/tmux.conf sourced'
bind R source-file ~/.config/tmux/tmux.conf \; display-message '~/.config/tmux/tmux.conf sourced'
bind u run-shell '~/.config/tmux/plugins/tpm/bindings/update_plugins'

# Reduce escape key delay for faster responsiveness, especially in Vim/Neovim.
# set -g escape-time 0

# Both are required to stop getting the garbage characters in tmux session when it
# attaches to a remote terminal from cursor or vscode
set -sg escape-time 500
set -g focus-events off

# Start window numbering at 1 instead of 0.
set-option -g base-index 1
set-window-option -g pane-base-index 1

# Automatically renumber windows after one is closed.
set-option -g renumber-windows on

# Use vi keybindings in copy mode.
set-window-option -g mode-keys vi

# Set Zsh as the default shell for new windows and panes.
set -g default-command "exec /bin/zsh"
set -g set-titles on
set -g set-titles-string "#h ❐ #S ● #I #W"

# Do not exit tmux when the last session is closed.
set -g detach-on-destroy off

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Terminal & Colors {{{
#-------------------------------------------------------------------------------

# Enable True Color support for modern terminals.
# set-option -sa terminal-overrides ",xterm*:Tc"

# Set the default terminal type for tmux itself.
# set -g default-terminal "tmux-256color"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: 2. PLUGINS {{{
#-------------------------------------------------------------------------------

# Managed by TPM (Tmux Plugin Manager).


#-------------------------------------------------------------------------------
# --- NOTE: Themes (enable one) {{{
#-------------------------------------------------------------------------------

# set -g @plugin 'dracula/tmux'
# set -g @plugin "nordtheme/tmux"
# set -g @plugin 'catppuccin/tmux'
# set -g @catppuccin_flavour 'mocha'
# set -g @plugin 'rose-pine/tmux'
# set -g @rose_pine_variant 'main'
# set -g @plugin 'khanghh/tmux-dark-plus-theme'

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Core & Utility Plugins {{{
#-------------------------------------------------------------------------------

# Load sensible default settings that most users agree on.
set -g @plugin 'tmux-plugins/tmux-sensible'

# Provides better, more intuitive mouse support.
set -g @plugin 'nhdaly/tmux-better-mouse-mode'

# Provides a better way to yank (copy) text to the system clipboard.
set -g @plugin 'tmux-plugins/tmux-yank'

# Enhances copy and paste with visual hints and easy navigation.
set -g @plugin 'Morantron/tmux-fingers'
set-option -g @fingers-key "F"

# Adds session dots in the status bar
set -g @plugin 'jtmcginty/tmux-session-dots'
set -g @session-dots-active "● "
set -g @session-dots-inactive "○ "
set -g @session-dots-color "#ffc600"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: tmux.expose {{{
#-------------------------------------------------------------------------------

# Mission Control-style session switcher with live previews
set -g @tmux-expose-key 'e'
set -g @tmux-expose-key-table 'prefix'
set -g @tmux-expose-width '100%'
set -g @tmux-expose-height '100%'
set -g @tmux-expose-style 'bg=#0d3a58'
set -g @tmux-expose-border-style 'fg=#0050a4,border-lines=rounded'
set -g @tmux-expose-selected-color '#ffc600'
set -g @tmux-expose-attached-color '#5fff00'
set -g @tmux-expose-inactive-color '#8a8a8a'

set -g @plugin 'cesarferreira/tmux.expose'

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Jump List {{{
#-------------------------------------------------------------------------------

set -g @plugin 'joryeugene/tmux-jumplist'

set -g @jumplist-key-back 'M-,'
set -g @jumplist-key-forward 'M-.'

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Back in 5 {{{
#-------------------------------------------------------------------------------

set -g @plugin 'hamolicious/back-in-5'

# Keep the plugin off the common lowercase prefix bindings. The actual
# user-facing entrypoint is defined explicitly in dev-mode below.
set-environment -g BACK_IN_5_LAUNCH_KEY 'B'

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Tome Playbook {{{
#-------------------------------------------------------------------------------
set -g @plugin 'laktak/tome'

# Set the keybinding to open the Tome playbook.
set -g @tome_key 'C-t'

# Set the keybinding to open the Tome scratchpad.
set -g @tome_scratch_key 'C-s'

# Set the width and height of the Tome popup window.
set -g @tome_size '40%'

# Set the Tome playbook type and path.
set -g @tome_playbook '.playbook.md'

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Tmux Tpad Config {{{
#       named popups for utility and second-brain files
#-------------------------------------------------------------------------------

set -g @plugin 'Subbeh/tmux-tpad'

# Configure tmux-tpad to use C-u for fullscreen to avoid overriding C-f,
# which is bound to file-picker-mode.
set -g @tpad-bind-fullscreen 'C-u'

#-------------------------------------------------------------------------------
# --- NOTE: 1. Global Path & Default Layout {{{
#-------------------------------------------------------------------------------
set -g @tpad-path "~/.config/tmux/scripts/tpad-wrapper.sh"

# NOTE: tmux-tpad maps style to tmux -S (border-style) and border_style to tmux -s (popup style)
# due to an internal mapping bug. Therefore we swap the values below.
set -g @tpad-default-style "fg=#00AAFF"
set -g @tpad-default-border-style "fg=#e4e4e4,bg=#193549"
set -g @tpad-default-border-lines "rounded"
set -g @tpad-default-width "90%"
set -g @tpad-default-height "90%"

# Apply defaults to all instances dynamically
run-shell '
  style="$(tmux show-option -gqv "@tpad-default-style")"
  border="$(tmux show-option -gqv "@tpad-default-border-style")"
  lines="$(tmux show-option -gqv "@tpad-default-border-lines")"
  w="$(tmux show-option -gqv "@tpad-default-width")"
  h="$(tmux show-option -gqv "@tpad-default-height")"

  for inst in lazygit lazydocker gh-dash process-viewer grimoire \
              notes-personal notes-work todos-personal todos-work \
              daily-personal-todo daily-work-todo scratch-personal scratch-work \
              journal-personal journal-work backup-logs scratchpad \
              ai-notes ai-journal \
              espanso-edit cht-sh manpage git-help regex-test worktree-logs; do
    tmux set -g "@tpad-${inst}-style" "$style"
    tmux set -g "@tpad-${inst}-border_style" "$border"
    tmux set -g "@tpad-${inst}-border_lines" "$lines"
    tmux set -g "@tpad-${inst}-width" "$w"
    tmux set -g "@tpad-${inst}-height" "$h"
  done
'
#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# --- NOTE: 2. Configure Commands & Titles {{{
#           (We do not set @tpad-<inst>-bind to prevent key collision inside Neovim/tools)
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# --- NOTE: Utility Instances {{{
#-------------------------------------------------------------------------------
set -g @tpad-lazygit-cmd "lazygit"
set -g @tpad-lazygit-title " Lazygit "
set -g @tpad-lazygit-per-dir "true"

set -g @tpad-lazydocker-cmd "lazydocker"
set -g @tpad-lazydocker-title " Lazydocker "

set -g @tpad-gh-dash-cmd "gh dash"
set -g @tpad-gh-dash-title " GitHub Dash "

set -g @tpad-process-viewer-cmd "btm"
set -g @tpad-process-viewer-title " Process Viewer "

set -g @tpad-grimoire-cmd "zsh"
set -g @tpad-grimoire-title " Grimoire Scratchpad "

set -g @tpad-scratchpad-cmd ""
set -g @tpad-scratchpad-title " Scratchpad "

#--- custom_shpell replacements ---
set -g @tpad-espanso-edit-cmd "espanso edit"
set -g @tpad-espanso-edit-title " Espanso Edit "

set -g @tpad-cht-sh-cmd "~/.config/tmux/scripts/cht-sh/cht.sh"
set -g @tpad-cht-sh-title " Cht.sh "

set -g @tpad-manpage-cmd "man zsh"
set -g @tpad-manpage-title " Man Page "

set -g @tpad-git-help-cmd "git help -a | less"
set -g @tpad-git-help-title " Git Help "

set -g @tpad-regex-test-cmd 'python3 -c "import re; help(re)" | less'
set -g @tpad-regex-test-title " Regex Help "

set -g @tpad-worktree-logs-cmd "nvim $HOME/.local/share/tmux/logs/git-worktree.log"
set -g @tpad-worktree-logs-title " Worktree Logs "
#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# --- NOTE: Second-brain Instances {{{
#-------------------------------------------------------------------------------
set -g @tpad-notes-personal-cmd "nvim $HOME/Projects/Personal/Github/second-brain/brain/notes/inbox.org"
set -g @tpad-notes-personal-title " Personal Notes "

set -g @tpad-notes-work-cmd "nvim $HOME/Projects/Work/Github/second-brain/notes/inbox.org"
set -g @tpad-notes-work-title " Work Notes "

set -g @tpad-todos-personal-cmd "nvim $HOME/Projects/Personal/Github/second-brain/daily/agenda/todos.org"
set -g @tpad-todos-personal-title " Personal Todos "

set -g @tpad-todos-work-cmd "nvim $HOME/Projects/Work/Github/second-brain/agenda/todos.org"
set -g @tpad-todos-work-title " Work Todos "

set -g @tpad-daily-personal-todo-cmd 'nvim $HOME/Projects/Personal/Github/second-brain/daily/agenda/daily/$(date +%Y-%m-%d).org'
set -g @tpad-daily-personal-todo-title " Daily Personal Todos "

set -g @tpad-daily-work-todo-cmd 'nvim $HOME/Projects/Work/Github/second-brain/agenda/daily/$(date +%Y-%m-%d).org'
set -g @tpad-daily-work-todo-title " Daily Work Todos "

set -g @tpad-scratch-personal-cmd "nvim $HOME/Projects/Personal/Github/second-brain/sandbox/scratch/inbox.org"
set -g @tpad-scratch-personal-title " Personal Scratchpad "

set -g @tpad-scratch-work-cmd "nvim $HOME/Projects/Work/Github/second-brain/scratch/inbox.org"
set -g @tpad-scratch-work-title " Work Scratchpad "

set -g @tpad-journal-personal-cmd 'nvim $HOME/Projects/Personal/Github/second-brain/daily/journal/$(date +%Y-%m-%d).org'
set -g @tpad-journal-personal-title " Personal Journal "

set -g @tpad-journal-work-cmd 'nvim $HOME/Projects/Work/Github/second-brain/journal/$(date +%Y-%m-%d).org'
set -g @tpad-journal-work-title " Work Journal "

set -g @tpad-ai-notes-cmd "nvim $HOME/Projects/Personal/Github/ai-brain/notes/inbox.md"
set -g @tpad-ai-notes-title " AI Notes "

set -g @tpad-ai-journal-cmd 'mkdir -p $HOME/Projects/Personal/Github/ai-brain/journal/$(date +%Y/%m) && nvim $HOME/Projects/Personal/Github/ai-brain/journal/$(date +%Y/%m/%d).md'
set -g @tpad-ai-journal-title " AI Journal "

set -g @tpad-backup-logs-cmd 'nvim $HOME/.local/share/backup-logs/'
set -g @tpad-backup-logs-title " Backup Logs "
#-------------------------------------------------------------------------------
