#-------------------------------------------------------------------------------
# --- NOTE: Git Mode {{{
#           Parent block for all git-mode functionality.
#           Enter git-mode by pressing C-a C-g.
#-------------------------------------------------------------------------------

# Git mode trigger
bind-key C-g switch-client -T git-mode

#-------------------------------------------------------------------------------
# --- NOTE: Git Mode - Keybindings {{{
#-------------------------------------------------------------------------------

# Launch the git worktree management script (interactive).
bind-key -T git-mode w display-popup -w 80% -h 80% -E "~/.config/tmux/scripts/git/git-worktree.sh"

# Global worktree manager: focus this session's manager, or create it at ~/Projects.
bind-key -T git-mode m run-shell "zsh ~/.config/tmux/scripts/worktree-manager.sh --launch"

# Create a new worktree.
bind-key -T git-mode c display-popup -w 80% -h 80% -E "~/.config/tmux/scripts/git/git-worktree.sh create"

# Switch to a worktree.
bind-key -T git-mode s display-popup -w 80% -h 80% -E "~/.config/tmux/scripts/git/git-worktree.sh switch"

# Delete a worktree.
bind-key -T git-mode d display-popup -w 80% -h 80% -E "~/.config/tmux/scripts/git/git-worktree.sh delete"

# Show worktrees for the current project, including branches with unmerged commits.
bind-key -T git-mode v display-popup -w 90% -h 80% -E "workmux list | less -RX"

# Open the Workmux dashboard for agent and worktree navigation.
bind-key -T git-mode a display-popup -w 95% -h 90% -E "workmux dashboard"

# Open the Workmux dashboard directly on its Worktrees tab.
bind-key -T git-mode o display-popup -w 95% -h 90% -E "workmux dashboard --tab worktrees"

# Review the current worktree's diff.
bind-key -T git-mode r display-popup -w 95% -h 90% -E "workmux dashboard --diff"

# Show worktrees with their GitHub pull request status.
bind-key -T git-mode p display-popup -w 90% -h 80% -E "workmux list --pr | less -RX"

# Show Git status and unmerged commit details for tracked agents.
bind-key -T git-mode i display-popup -w 90% -h 80% -E "workmux status --git | less -RX"

# Toggle the persistent Workmux agent sidebar.
bind-key -T git-mode b run-shell "workmux sidebar"

# Git worktree logs
bind-key -T git-mode l run-shell "#{@tpad-path} toggle worktree-logs"

# Workmux command palette — lifecycle actions in a temporary window.
bind-key -T git-mode x new-window -n wm-palette "~/.config/tmux/scripts/popup/workmux-palette.sh"

# Checkout a GitHub/GitLab PR into a new worktree (gum prompt for # or URL)
bind-key -T git-mode P display-popup -w 80% -h 80% -E "~/.config/tmux/scripts/git/pr-checkout.sh"

# Jump to the agent that most recently finished or is waiting for input
bind-key -T git-mode . run-shell "workmux last-done"

# Toggle between the current and the previously visited agent
bind-key -T git-mode t run-shell "workmux last-agent"

# Restore worktree windows (and agent conversations) after a crash
bind-key -T git-mode R run-shell "workmux resurrect"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# --- NOTE: Git Mode - Help & Navigation {{{
#-------------------------------------------------------------------------------

# Help for git mode
bind-key -T git-mode ? run-shell "$HOME/.config/tmux/scripts/popup/help/help.sh git-mode"

# Exit git mode
bind-key -T git-mode q switch-client -T root

