# Back in 5 status screen.
bind-key -T dev-mode b display-popup -E -B -w 100% -h 100% -x 0% -y 0% "~/.config/tmux/plugins/back-in-5/scripts/main.sh"

# Toggle general scratchpad
bind -T dev-mode s run-shell "#{@tpad-path} toggle scratchpad"

