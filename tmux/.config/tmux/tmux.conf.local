# Second-brain mode trigger
bind-key C-b switch-client -T second-brain


#-------------------------------------------------------------------------------
# --- NOTE: Second-Brain Keybindings {{{
#-------------------------------------------------------------------------------

# Notes
bind-key -T second-brain n run-shell "#{@tpad-path} toggle notes-personal"
bind-key -T second-brain N run-shell "#{@tpad-path} toggle notes-work"

# Todos
bind-key -T second-brain t run-shell "#{@tpad-path} toggle todos-personal"
bind-key -T second-brain T run-shell "#{@tpad-path} toggle todos-work"

# Daily Todos
bind-key -T second-brain d run-shell "#{@tpad-path} toggle daily-personal-todo"
bind-key -T second-brain D run-shell "#{@tpad-path} toggle daily-work-todo"

# Scratch
bind-key -T second-brain s run-shell "#{@tpad-path} toggle scratch-personal"
bind-key -T second-brain S run-shell "#{@tpad-path} toggle scratch-work"

# Journal (persistent - daily entries)
bind-key -T second-brain j run-shell "#{@tpad-path} toggle journal-personal"
bind-key -T second-brain J run-shell "#{@tpad-path} toggle journal-work"

# AI Brain
bind-key -T second-brain i run-shell "#{@tpad-path} toggle ai-notes"
bind-key -T second-brain I run-shell "#{@tpad-path} toggle ai-journal"

# Search/Find bindings
bind-key -T second-brain f display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh text"
bind-key -T second-brain g display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh file"
bind-key -T second-brain p display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh text personal"
bind-key -T second-brain w display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh text work"
bind-key -T second-brain a display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh text ai"
bind-key -T second-brain k display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh file personal"
bind-key -T second-brain h display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh file work"
bind-key -T second-brain c display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/popup/second-brain-search.sh file ai"

# backup logs
bind-key -T second-brain l run-shell "#{@tpad-path} toggle backup-logs"

# Exit second-brain mode
bind-key -T second-brain q switch-client -T root

# Help for second-brain
bind -T second-brain ? run-shell "$HOME/.config/tmux/scripts/popup/help/help.sh second-brain"

# >>> debug: run reload helper in new window to see error
bind-key -T second-brain 0 new-window 'h=$(find /tmp -maxdepth 1 -name "sb-cycle-helper-*" 2>/dev/null | head -1); c=$(find /tmp -maxdepth 1 -name "sb-cycle-*" ! -name "*-helper-*" 2>/dev/null | head -1); echo "Helper: $h"; echo "Cycle: $c"; if [ -n "$h" ] && [ -n "$c" ]; then bash -x "$h" "$c" text; echo "--- EXIT CODE: $? ---"; else echo "Temp files not found. Open C-a C-b f first, then press C-a C-b 0."; fi; echo ""; exec bash -i'

#-------------------------------------------------------------------------------
# }}}
