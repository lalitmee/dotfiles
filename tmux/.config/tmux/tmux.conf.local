#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode {{{
#           Parent block for all layout-mode functionality.
#           Enter layout-mode by pressing C-l (without prefix).
#-------------------------------------------------------------------------------

# Layout mode trigger - Enter layout-mode by pressing C-b (without prefix)
bind -T root C-b switch-client -T layout-mode


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode - Window Management {{{
#           Basic window and pane creation/management bindings.
#-------------------------------------------------------------------------------

# Toggle the status bar on/off.
bind -T layout-mode C-b set-option status

# Split window horizontally (easier to press than ").
bind -T layout-mode v splitw -d -c '#{pane_current_path}'

# Split window vertically (easier to press than %).
bind -T layout-mode H splitw -hd -c '#{pane_current_path}'

# Kill the bottom-most pane.
bind -T layout-mode q kill-pane -t '#{bottom}'

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode - Pane Splitting {{{
#           Advanced pane splitting with specific size ratios.
#-------------------------------------------------------------------------------

# Split with a 40% horizontal pane to the left.
bind -T layout-mode h splitw -hbp 40 -c '#{pane_current_path}'

# Split with a 40% horizontal pane to the right.
bind -T layout-mode l splitw -hp 40 -c '#{pane_current_path}'

# Split with a 30% vertical pane below.
bind -T layout-mode j splitw -p 30 -c '#{pane_current_path}'

# Split with a 30% vertical pane above.
bind -T layout-mode k splitw -bp 30 -c '#{pane_current_path}'

# Prompt for a window name before creating a new window in the current path.
bind -T layout-mode n command-prompt -p "window name:" -I "" "new-window -c '#{pane_current_path}' -n '%1'"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode - File Operations {{{
#           File and process management operations.
#-------------------------------------------------------------------------------

# Launch a script to search lines in files and open in editor.
bind -T layout-mode C-o run-shell "tmux neww tsnv"

# Kill a user process via fzf.
bind -T layout-mode x display-popup -w 80% -h 80% -E "~/.config/tmux/scripts/kill-process.sh"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode - Git Operations {{{
#           Git repository management.
#-------------------------------------------------------------------------------

bind -T layout-mode g display-popup -w 60% -h 70% -E "~/.config/tmux/scripts/git-pull-merge.sh"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode - Pane Buffer Editing {{{
#           Edit pane scrollback history in Neovim.
#-------------------------------------------------------------------------------

# View/edit pane content in popup Neovim (Option+e)
# Opens at your current scroll position for seamless continuation
# Creates a temporary file that's cleaned up on exit
bind -n M-e display-popup -E -w 90% -h 90% "\
  f=\$(mktemp /tmp/tmux-pane-XXXXXX); \
  SCROLL=\$(tmux display-message -p '#{scroll_position}'); \
  LINES=\$(tmux capture-pane -p -S - | wc -l); \
  LINE=\$((LINES - SCROLL)); \
  tmux capture-pane -p -S - > \$f; \
  nvim +'set binary noeol' +\${LINE} \$f; \
  rm -f \$f"

# Capture visible scrollback in new window
bind -T layout-mode e run "
  f=\$(mktemp /tmp/tmux-edit.XXXXXX) && \
  tmux capture-pane -S 0 -p -J > \$f && \
  tmux new-window \
    -n 'hist-#{session_name}:#{window_index}.#{pane_index}' \
    \"sh -c 'trap \\\"rm -f \$f\\\" EXIT; nvim \$f'\"
"

# Capture full scrollback in new window
bind -T layout-mode E run "
  f=\$(mktemp /tmp/tmux-edit.XXXXXX) && \
  tmux capture-pane -S - -p -J > \$f && \
  tmux new-window \
    -n 'hist-#{session_name}:#{window_index}.#{pane_index}' \
    \"sh -c 'trap \\\"rm -f \$f\\\" EXIT; nvim \$f'\"
"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode - Documentation {{{
#           Access documentation and help systems.
#-------------------------------------------------------------------------------

# Unified Documentation Browser - fzf-based script for finding and opening documentation
bind -T layout-mode m display-popup -w 90% -h 90% -E "~/.config/tmux/scripts/doc-finder.sh"

#-------------------------------------------------------------------------------
# }}}
#-------------------------------------------------------------------------------


#-------------------------------------------------------------------------------
# --- NOTE: Layout Mode - Help {{{
#           Help and information for layout mode.
#-------------------------------------------------------------------------------

# Help for layout mode
bind -T layout-mode ? run-shell "$HOME/.config/tmux/scripts/popup/help/help.sh layout-mode"

